# Environment
DATABASE_URL="postgresql://inzorya:inzorya@localhost:5433/inzorya?schema=public"
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Token vault (AES-256-GCM). Prefer a dedicated 32+ char secret.
TOKEN_ENCRYPTION_KEY="replace-with-openssl-rand-base64-32"

# Meta / Facebook app (leave empty for local sandbox connect)
META_APP_ID=""
META_APP_SECRET=""
META_GRAPH_API_VERSION="v21.0"
META_OAUTH_REDIRECT_URI="http://localhost:3000/api/integrations/meta/callback"
# Keep false until ready to call Meta Graph APIs
META_API_ENABLED="false"
# When credentials are missing, Channels can complete a local sandbox connect
META_OAUTH_SANDBOX="true"
# Used for webhook hub.verify_token checks
META_WEBHOOK_VERIFY_TOKEN="replace-with-random-verify-token"

# AI Core Platform (provider-agnostic; mock by default)
AI_PLATFORM_ENABLED="true"
AI_FORCE_MOCK="true"
AI_PROVIDER_PRIORITY="mock,openai,anthropic,gemini,openrouter,local"
AI_ROUTE_PREFERENCE="balanced"
AI_DEFAULT_TIMEOUT_MS="30000"
AI_MAX_RETRIES="2"
AI_DAILY_COST_LIM`IT_USD="50"
# Leave empty until live providers are enabled
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
RESEND_API_KEY=""
FIRECRAWL_API_KEY=""
CALENDARIFIC_API_KEY=""
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
TAVILY_API_KEY=""
EVENTBRITE_API_TOKEN=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
GOOGLE_AI_API_KEY=""
OPENROUTER_API_KEY=""
AI_LOCAL_ENABLED="false"
