# Environment
DATABASE_URL="postgresql://inzorya:inzorya@localhost:5433/inzorya?schema=public"
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Token vault (AES-256-GCM). Prefer a dedicated 32+ char secret.
TOKEN_ENCRYPTION_KEY="replace-with-openssl-rand-base64-32"

# Meta / Facebook app (leave empty for local sandbox connect)
META_APP_ID=""
META_APP_SECRET=""
META_GRAPH_API_VERSION="v21.0"
META_OAUTH_REDIRECT_URI="http://localhost:3000/api/integrations/meta/callback"
# Keep false until ready to call Meta Graph APIs
META_API_ENABLED="false"
# When credentials are missing, Channels can complete a local sandbox connect
META_OAUTH_SANDBOX="true"
# Used for webhook hub.verify_token checks
META_WEBHOOK_VERIFY_TOKEN="replace-with-random-verify-token"
