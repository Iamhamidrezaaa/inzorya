generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum ContentStatus {
  IDEAS
  RESEARCH
  BRIEF
  DRAFT
  REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum ContentPlatform {
  INSTAGRAM
  FACEBOOK
  LINKEDIN
  X
  TIKTOK
  YOUTUBE
  BLOG
  EMAIL
  NEWSLETTER
  OTHER
}

enum ContentFormat {
  INSTAGRAM_REEL
  INSTAGRAM_CAROUSEL
  INSTAGRAM_STORY
  INSTAGRAM_POST
  FACEBOOK
  LINKEDIN
  X
  TIKTOK
  YOUTUBE
  SHORT
  NEWSLETTER
  BLOG
  OTHER
}

enum ContentPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CampaignStatus {
  PLANNING
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum ChannelPlatform {
  INSTAGRAM
  FACEBOOK
  WHATSAPP
  TELEGRAM
  X
  LINKEDIN
  YOUTUBE
  TIKTOK
}

enum ChannelStatus {
  DISCONNECTED
  CONNECTED
  PENDING
  ERROR
}

enum ConversationStatus {
  OPEN
  CLOSED
  ARCHIVED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

model User {
  id            String            @id @default(cuid())
  name          String?
  email         String            @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  accounts      Account[]
  sessions      Session[]
  memberships   WorkspaceMember[]
  assigned      Conversation[]    @relation("ConversationAssignee")
  contentAssigned ContentItem[]   @relation("ContentAssignee")
  contentComments ContentComment[]
  notifications Notification[]
  favorites     Favorite[]
  recentItems   RecentItem[]
  activities    Activity[]        @relation("ActivityActor")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model Workspace {
  id            String            @id @default(cuid())
  name          String
  slug          String            @unique
  members       WorkspaceMember[]
  brands        Brand[]
  notifications Notification[]
  activities    Activity[]
  favorites     Favorite[]
  recentItems   RecentItem[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(EDITOR)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Brand {
  id             String              @id @default(cuid())
  workspaceId    String
  name           String
  slug           String
  description    String?
  website        String?
  logoUrl        String?
  industry       String?
  brandVoice     String?             @db.Text
  targetAudience String?             @db.Text
  primaryColor   String?             @default("#14b8a6")
  secondaryColor String?             @default("#0f172a")
  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  businessProfile BusinessProfile?
  documents      KnowledgeDocument[]
  contents       ContentItem[]
  media          MediaAsset[]
  campaigns      Campaign[]
  templates      ContentTemplate[]
  editorialSlots EditorialCalendar[]
  contacts       Contact[]
  channelConnections ChannelConnection[]
  conversations  Conversation[]
  marketingStrategy MarketingStrategy?
  businessBrain     BusinessBrain?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  archivedAt     DateTime?

  @@unique([workspaceId, slug])
  @@index([workspaceId])
}

/// Structured marketing strategy workspace — no AI generation; data for future planning.
model MarketingStrategy {
  id                 String            @id @default(cuid())
  brandId            String            @unique
  /// Selected marketing goal keys (e.g. increase_sales)
  goals              String[]          @default([])
  postingFrequency   String?
  preferredPlatforms String[]          @default([])
  /// REELS | CAROUSEL | STORY | SHORTS | POST
  contentTypes       String[]          @default([])
  tone               String?
  contentLength      String?
  ctaStyle           String?
  currentStage       String?
  nextStep           String?
  brand              Brand             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  personas           AudiencePersona[]
  competitors        Competitor[]
  pillars            ContentPillar[]
  roadmapTasks       RoadmapTask[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model AudiencePersona {
  id                String            @id @default(cuid())
  strategyId        String
  name              String
  age               String?
  gender            String?
  location          String?
  interests         String?           @db.Text
  painPoints        String?           @db.Text
  buyingMotivation  String?           @db.Text
  objections        String?           @db.Text
  goals             String?           @db.Text
  sortOrder         Int               @default(0)
  strategy          MarketingStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([strategyId, sortOrder])
}

model Competitor {
  id         String            @id @default(cuid())
  strategyId String
  name       String
  website    String?
  instagram  String?
  notes      String?           @db.Text
  sortOrder  Int               @default(0)
  strategy   MarketingStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([strategyId, sortOrder])
}

model ContentPillar {
  id          String            @id @default(cuid())
  strategyId  String
  name        String
  description String?
  color       String?           @default("#14b8a6")
  sortOrder   Int               @default(0)
  archivedAt  DateTime?
  strategy    MarketingStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  contents    ContentItem[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([strategyId, sortOrder])
}

model RoadmapTask {
  id         String            @id @default(cuid())
  strategyId String
  title      String
  done       Boolean           @default(false)
  sortOrder  Int               @default(0)
  strategy   MarketingStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([strategyId, sortOrder])
}

model BusinessProfile {
  id                    String   @id @default(cuid())
  brandId               String   @unique
  businessSummary       String?  @db.Text
  industry              String?
  website               String?
  country               String?
  languages             String[] @default([])
  businessGoals         String?  @db.Text
  mainProducts          String?  @db.Text
  targetAudience        String?  @db.Text
  competitors           String?  @db.Text
  brandPersonality      String?  @db.Text
  preferredTone         String?
  contentStyle          String?  @db.Text
  mainCta               String?
  postingFrequency      String?
  preferredPlatforms    String[] @default([])
  marketingChallenges   String?  @db.Text
  monthlyBudget         String?
  teamSize              String?
  onboardingStep        Int      @default(0)
  onboardingCompletedAt DateTime?
  brand                 Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

/// Catalog of supported social platforms. OAuth providers plug in via ChannelConnection later.
model SocialChannel {
  id          String              @id @default(cuid())
  platform    ChannelPlatform     @unique
  name        String
  description String?
  connections ChannelConnection[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model ChannelConnection {
  id                String              @id @default(cuid())
  brandId           String
  socialChannelId   String
  status            ChannelStatus       @default(DISCONNECTED)
  accountName       String?
  accountHandle     String?
  /// Reserved for real OAuth account id
  externalAccountId String?
  /// Reserved for encrypted tokens / provider metadata (never store plaintext tokens in UI mocks)
  providerMeta      Json?
  lastSyncAt        DateTime?
  brand             Brand               @relation(fields: [brandId], references: [id], onDelete: Cascade)
  socialChannel     SocialChannel       @relation(fields: [socialChannelId], references: [id], onDelete: Cascade)
  permissions       ChannelPermission[]
  conversations     Conversation[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([brandId, socialChannelId])
  @@index([brandId])
  @@index([status])
}

model ChannelPermission {
  id           String            @id @default(cuid())
  connectionId String
  scope        String
  label        String
  granted      Boolean           @default(false)
  connection   ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([connectionId, scope])
  @@index([connectionId])
}

model KnowledgeDocument {
  id        String   @id @default(cuid())
  brandId   String
  title     String
  body      String   @default("") @db.Text
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId])
  @@index([brandId, title])
}

model ContentItem {
  id             String                 @id @default(cuid())
  brandId        String
  title          String
  body           String                 @default("") @db.Text
  description    String?                @db.Text
  objective      String?                @db.Text
  targetAudience String?                @db.Text
  notes          String?                @db.Text
  status         ContentStatus          @default(IDEAS)
  platform       ContentPlatform        @default(INSTAGRAM)
  format         ContentFormat          @default(INSTAGRAM_POST)
  priority       ContentPriority        @default(MEDIUM)
  campaignId     String?
  pillarId       String?
  assigneeId     String?
  dueDate        DateTime?
  scheduledAt    DateTime?
  publishedAt    DateTime?
  sortOrder      Int                    @default(0)
  deletedAt      DateTime?
  brand          Brand                  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  campaign       Campaign?              @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  pillar         ContentPillar?         @relation(fields: [pillarId], references: [id], onDelete: SetNull)
  assignee       User?                  @relation("ContentAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  brief          ContentBrief?
  checklist      ContentChecklistItem[]
  comments       ContentComment[]
  attachments    ContentAttachment[]
  calendarSlots  EditorialCalendar[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([brandId, status, sortOrder])
  @@index([brandId, campaignId])
  @@index([brandId, dueDate])
  @@index([brandId, scheduledAt])
  @@index([deletedAt])
}

model ContentBrief {
  id             String      @id @default(cuid())
  contentId      String      @unique
  goal           String?     @db.Text
  hook           String?     @db.Text
  problem        String?     @db.Text
  solution       String?     @db.Text
  cta            String?
  targetAudience String?     @db.Text
  references     String?     @db.Text
  keywords       String[]    @default([])
  hashtags       String[]    @default([])
  competitors    String?     @db.Text
  content        ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model ContentChecklistItem {
  id        String      @id @default(cuid())
  contentId String
  label     String
  done      Boolean     @default(false)
  sortOrder Int         @default(0)
  content   ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([contentId, sortOrder])
}

model ContentComment {
  id        String      @id @default(cuid())
  contentId String
  userId    String
  body      String      @db.Text
  mentions  String[]    @default([])
  deletedAt DateTime?
  content   ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([contentId, createdAt])
}

model ContentAttachment {
  id        String      @id @default(cuid())
  contentId String
  mediaId   String?
  label     String?
  url       String
  content   ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)
  media     MediaAsset? @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  createdAt DateTime    @default(now())

  @@index([contentId])
}

model ContentTemplate {
  id          String          @id @default(cuid())
  brandId     String
  name        String
  description String?
  category    String?
  format      ContentFormat   @default(INSTAGRAM_POST)
  platform    ContentPlatform @default(INSTAGRAM)
  titleHint   String?
  briefGoal   String?         @db.Text
  briefHook   String?         @db.Text
  checklist   String[]        @default([])
  archivedAt  DateTime?
  brand       Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([brandId, archivedAt])
}

model EditorialCalendar {
  id        String       @id @default(cuid())
  brandId   String
  contentId String?
  title     String
  date      DateTime
  note      String?
  content   ContentItem? @relation(fields: [contentId], references: [id], onDelete: SetNull)
  brand     Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([brandId, date])
}

model MediaAsset {
  id           String              @id @default(cuid())
  brandId      String
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  kind         String              @default("image")
  tags         String[]            @default([])
  folder       String?
  deletedAt    DateTime?
  brand        Brand               @relation(fields: [brandId], references: [id], onDelete: Cascade)
  attachments  ContentAttachment[]
  createdAt    DateTime            @default(now())

  @@index([brandId, folder])
  @@index([brandId, deletedAt])
}

model Campaign {
  id          String         @id @default(cuid())
  brandId     String
  name        String
  description String?        @db.Text
  objective   String?        @db.Text
  platforms   String[]       @default([])
  startDate   DateTime?
  endDate     DateTime?
  budget      String?
  status      CampaignStatus @default(PLANNING)
  color       String?        @default("#14b8a6")
  icon        String?
  archivedAt  DateTime?
  brand       Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  contents    ContentItem[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([brandId, status])
}

model Contact {
  id                String         @id @default(cuid())
  brandId           String
  name              String?
  instagramUsername String?
  phone             String?
  email             String?
  tags              String[]       @default([])
  notes             String?        @db.Text
  brand             Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  conversations     Conversation[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([brandId])
  @@index([brandId, instagramUsername])
}

model Conversation {
  id            String             @id @default(cuid())
  brandId       String
  contactId     String
  channelId     String?
  status        ConversationStatus @default(OPEN)
  isUnread      Boolean            @default(true)
  assigneeId    String?
  subject       String?
  lastMessageAt DateTime           @default(now())
  brand         Brand              @relation(fields: [brandId], references: [id], onDelete: Cascade)
  contact       Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channel       ChannelConnection? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  assignee      User?              @relation("ConversationAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages      Message[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([brandId, status])
  @@index([brandId, isUnread])
  @@index([brandId, lastMessageAt])
  @@index([contactId])
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  body           String           @db.Text
  direction      MessageDirection
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
}

enum NotificationType {
  SYSTEM
  WORKSPACE
  CHANNEL
  CONVERSATION
  CONTENT
  STRATEGY
}

enum ActivityKind {
  BUSINESS_UPDATED
  CHANNEL_CONNECTED
  CHANNEL_DISCONNECTED
  KNOWLEDGE_CREATED
  KNOWLEDGE_UPDATED
  CONTENT_CREATED
  CONTENT_UPDATED
  CONTACT_CREATED
  PERSONA_UPDATED
  STRATEGY_UPDATED
  FAVORITE_ADDED
  SYSTEM
}

enum EntityTargetType {
  PAGE
  KNOWLEDGE
  CONTACT
  CONTENT
  CHANNEL
  SETTINGS
}

model Notification {
  id          String           @id @default(cuid())
  workspaceId String
  userId      String
  type        NotificationType
  title       String
  body        String?
  href        String?
  readAt      DateTime?
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())

  @@index([userId, workspaceId, createdAt])
  @@index([userId, readAt])
}

model Activity {
  id          String       @id @default(cuid())
  workspaceId String
  brandId     String?
  userId      String?
  kind        ActivityKind
  title       String
  description String?
  href        String?
  meta        Json?
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User?        @relation("ActivityActor", fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())

  @@index([workspaceId, createdAt])
  @@index([brandId, createdAt])
}

model Favorite {
  id          String           @id @default(cuid())
  userId      String
  workspaceId String
  targetType  EntityTargetType
  targetId    String
  title       String
  href        String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())

  @@unique([userId, workspaceId, targetType, targetId])
  @@index([userId, workspaceId])
}

model RecentItem {
  id          String           @id @default(cuid())
  userId      String
  workspaceId String
  targetType  EntityTargetType
  targetId    String
  title       String
  href        String
  visitedAt   DateTime         @default(now())
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId, targetType, targetId])
  @@index([userId, workspaceId, visitedAt])
}

/// First-class Business Brain — structured knowledge for future AI (no LLM in this sprint).
model BusinessBrain {
  id                   String                 @id @default(cuid())
  brandId              String                 @unique
  currentQuestionKey   String?
  interviewStartedAt   DateTime?
  interviewCompletedAt DateTime?
  score                Int                    @default(0)
  completionPercent    Int                    @default(0)
  version              Int                    @default(1)
  deletedAt            DateTime?
  brand                Brand                  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  answers              BusinessAnswer[]
  voice                BrandVoice?
  assets               BrandAsset[]
  versions             BusinessBrainVersion[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([deletedAt])
}

model BusinessQuestion {
  id                String           @id @default(cuid())
  key               String           @unique
  groupKey          String
  sortOrder         Int              @default(0)
  prompt            String
  helpText          String?
  inputType         String
  options           String[]         @default([])
  estimatedSeconds  Int              @default(45)
  required          Boolean          @default(false)
  answers           BusinessAnswer[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([groupKey, sortOrder])
}

model BusinessAnswer {
  id         String           @id @default(cuid())
  brainId    String
  questionId String
  /// Plain text or JSON-serialized value (arrays, objects)
  value      String           @db.Text
  valueJson  Json?
  deletedAt  DateTime?
  brain      BusinessBrain    @relation(fields: [brainId], references: [id], onDelete: Cascade)
  question   BusinessQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([brainId, questionId])
  @@index([brainId, deletedAt])
}

model BrandVoice {
  id               String        @id @default(cuid())
  brainId          String        @unique
  traits           String[]      @default([])
  toneOfVoice      String?
  emojiUsage       String?
  writingStyle     String?
  ctaStyle         String?
  forbiddenWords   String[]      @default([])
  preferredWords   String[]      @default([])
  deletedAt        DateTime?
  brain            BusinessBrain @relation(fields: [brainId], references: [id], onDelete: Cascade)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model BrandAsset {
  id           String        @id @default(cuid())
  brainId      String
  kind         String
  label        String?
  url          String
  filename     String?
  originalName String?
  mimeType     String?
  size         Int?
  meta         Json?
  deletedAt    DateTime?
  brain        BusinessBrain @relation(fields: [brainId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([brainId, kind, deletedAt])
}

model BusinessBrainVersion {
  id          String        @id @default(cuid())
  brainId     String
  version     Int
  snapshot    Json
  note        String?
  createdAt   DateTime      @default(now())
  brain       BusinessBrain @relation(fields: [brainId], references: [id], onDelete: Cascade)

  @@unique([brainId, version])
  @@index([brainId, createdAt])
}


