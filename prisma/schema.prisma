  updatedAt   DateTime @updatedAt

  @@index([brandId])
}

model Report {
  id          String   @id @default(cuid())
  brandId     String
  templateId  String?
  name        String
  rangeLabel  String?
  metrics     String[] @default([])
  charts      String[] @default([])
  payload     Json?
