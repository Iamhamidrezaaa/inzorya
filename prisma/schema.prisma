enum NotificationType {
  SYSTEM
  WORKSPACE
  CHANNEL
  CONVERSATION
  CONTENT
  STRATEGY
}

enum ActivityKind {
  BUSINESS_UPDATED
  CHANNEL_CONNECTED
  CHANNEL_DISCONNECTED
  KNOWLEDGE_CREATED
  KNOWLEDGE_UPDATED
  CONTENT_CREATED
  CONTENT_UPDATED
  CONTACT_CREATED
  PERSONA_UPDATED
  STRATEGY_UPDATED
  FAVORITE_ADDED
  SYSTEM
}

enum EntityTargetType {
  PAGE
  KNOWLEDGE
