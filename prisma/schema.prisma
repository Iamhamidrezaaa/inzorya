generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum ContentStatus {
  IDEAS
  RESEARCH
  BRIEF
  DRAFT
  REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum ContentPlatform {
  INSTAGRAM
  FACEBOOK
  LINKEDIN
  X
  TIKTOK
  YOUTUBE
  BLOG
  EMAIL
  NEWSLETTER
  OTHER
}

enum ContentFormat {
  INSTAGRAM_REEL
  INSTAGRAM_CAROUSEL
  INSTAGRAM_STORY
  INSTAGRAM_POST
  FACEBOOK
  LINKEDIN
  X
  TIKTOK
  YOUTUBE
  SHORT
  NEWSLETTER
  BLOG
  OTHER
}

enum ContentPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CampaignStatus {
  PLANNING
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum ChannelPlatform {
  INSTAGRAM
  FACEBOOK
  WHATSAPP
  TELEGRAM
  X
  LINKEDIN
  YOUTUBE
  TIKTOK
}

enum ChannelStatus {
  DISCONNECTED
  CONNECTED
  PENDING
  ERROR
}

enum ConnectionHealth {
  HEALTHY
  PERMISSION_EXPIRED
  RECONNECT_REQUIRED
  SYNC_FAILED
  PENDING
}

enum OAuthSessionStatus {
  PENDING
  COMPLETED
  EXPIRED
  FAILED
  CONSUMED
}

enum TokenCredentialStatus {
  ACTIVE
  EXPIRED
  REVOKED
  ROTATING
}

enum SyncJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum WebhookSubscriptionStatus {
  DRAFT
  ACTIVE
  PAUSED
  ERROR
}

enum IntegrationAuditKind {
  OAUTH_START
  OAUTH_CALLBACK
  OAUTH_SUCCESS
  OAUTH_FAILURE
  TOKEN_STORED
  TOKEN_ROTATED
  TOKEN_REVOKED
  PERMISSION_CHANGE
  SYNC_QUEUED
  SYNC_COMPLETED
  SYNC_FAILED
  WEBHOOK_VALIDATED
  WEBHOOK_REJECTED
  SECURITY
  DISCONNECT
  RECONNECT
}

enum ConversationStatus {
  OPEN
  WAITING
  RESOLVED
  CLOSED
  ARCHIVED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  SYSTEM
}

enum MessageKind {
  TEXT
  IMAGE
  VIDEO
  VOICE
  FILE
  EMOJI
  LINK
  SYSTEM
}

enum MessageDeliveryStatus {
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum ConversationEventType {
  STARTED
  CHANNEL_CONNECTED
  ASSIGNED
  UNASSIGNED
  STATUS_CHANGED
  TAGGED
  UNTAGGED
  NOTE_ADDED
  STARRED
  UNSTARRED
  CLOSED
  REOPENED
  MESSAGE_SENT
}

model User {
  id            String            @id @default(cuid())
  name          String?
  email         String            @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  accounts      Account[]
  sessions      Session[]
  memberships   WorkspaceMember[]
  assigned      Conversation[]    @relation("ConversationAssignee")
  contentAssigned ContentItem[]   @relation("ContentAssignee")
  contentComments ContentComment[]
  inboxNotes    InternalNote[]
  inboxAssignments Assignment[]   @relation("AssignmentAssignee")
  inboxAssigner Assignment[]      @relation("AssignmentAssigner")
  conversationEvents ConversationEvent[]
  authoredMessages Message[]      @relation("MessageAuthor")
  conversationParts ConversationParticipant[]
  notifications Notification[]
  favorites     Favorite[]
  recentItems   RecentItem[]
  activities    Activity[]        @relation("ActivityActor")
  automationsCreated Automation[] @relation("AutomationCreator")
  automationVersions AutomationVersion[] @relation("AutomationVersionAuthor")
  oauthSessions      OAuthSession[]
  integrationAudits  IntegrationAuditLog[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model Workspace {
  id            String            @id @default(cuid())
  name          String
  slug          String            @unique
  members       WorkspaceMember[]
  brands        Brand[]
  notifications Notification[]
  activities    Activity[]
  favorites     Favorite[]
  recentItems   RecentItem[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(EDITOR)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Brand {
  id             String              @id @default(cuid())
  workspaceId    String
  name           String
  slug           String
  description    String?
  website        String?
  logoUrl        String?
  industry       String?
  brandVoice     String?             @db.Text
  targetAudience String?             @db.Text
  primaryColor   String?             @default("#14b8a6")
  secondaryColor String?             @default("#0f172a")
  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  businessProfile BusinessProfile?
  documents      KnowledgeDocument[]
  contents       ContentItem[]
  media          MediaAsset[]
  campaigns      Campaign[]
  templates      ContentTemplate[]
  editorialSlots EditorialCalendar[]
  contacts       Contact[]
  inboxTags      InboxTag[]
  savedReplies   SavedReply[]
  internalNotes  InternalNote[]
  channelConnections ChannelConnection[]
  conversations  Conversation[]
  automations    Automation[]
  connectedAccounts ConnectedAccount[]
  oauthSessions  OAuthSession[]
  webhookSubscriptions WebhookSubscription[]
  syncJobs       SyncJob[]
  integrationAudits IntegrationAuditLog[]
  analyticsSnapshots AnalyticsSnapshot[]
  kpis               Kpi[]
  audienceSnapshots  AudienceSnapshot[]
  contentMetrics     ContentMetric[]
  campaignMetrics    CampaignMetric[]
  channelMetrics     ChannelMetric[]
  insights           Insight[]
  reports            Report[]
  reportTemplates    ReportTemplate[]
  marketingStrategy MarketingStrategy?
  businessBrain     BusinessBrain?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  archivedAt     DateTime?

  @@unique([workspaceId, slug])
  @@index([workspaceId])
}

/// Structured marketing strategy workspace — no AI generation; data for future planning.
model MarketingStrategy {
  id                 String            @id @default(cuid())
  brandId            String            @unique
  /// Selected marketing goal keys (e.g. increase_sales)
  goals              String[]          @default([])
  postingFrequency   String?
  preferredPlatforms String[]          @default([])
  /// REELS | CAROUSEL | STORY | SHORTS | POST
  contentTypes       String[]          @default([])
  tone               String?
  contentLength      String?
  ctaStyle           String?
  currentStage       String?
  nextStep           String?
  brand              Brand             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  personas           AudiencePersona[]
  competitors        Competitor[]
  pillars            ContentPillar[]
  roadmapTasks       RoadmapTask[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model AudiencePersona {
  id                String            @id @default(cuid())
  strategyId        String
  name              String
  age               String?
  gender            String?
  location          String?
  interests         String?           @db.Text
  painPoints        String?           @db.Text
  buyingMotivation  String?           @db.Text
  objections        String?           @db.Text
  goals             String?           @db.Text
  sortOrder         Int               @default(0)
  strategy          MarketingStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([strategyId, sortOrder])
}

model Competitor {
  id         String            @id @default(cuid())
  strategyId String
  name       String
  website    String?
  instagram  String?
  notes      String?           @db.Text
  sortOrder  Int               @default(0)
  strategy   MarketingStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([strategyId, sortOrder])
}

model ContentPillar {
  id          String            @id @default(cuid())
  strategyId  String
  name        String
  description String?
  color       String?           @default("#14b8a6")
  sortOrder   Int               @default(0)
  archivedAt  DateTime?
  strategy    MarketingStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  contents    ContentItem[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([strategyId, sortOrder])
}

model RoadmapTask {
  id         String            @id @default(cuid())
  strategyId String
  title      String
  done       Boolean           @default(false)
  sortOrder  Int               @default(0)
  strategy   MarketingStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([strategyId, sortOrder])
}

model BusinessProfile {
  id                    String   @id @default(cuid())
  brandId               String   @unique
  businessSummary       String?  @db.Text
  industry              String?
  website               String?
  country               String?
  languages             String[] @default([])
  businessGoals         String?  @db.Text
  mainProducts          String?  @db.Text
  targetAudience        String?  @db.Text
  competitors           String?  @db.Text
  brandPersonality      String?  @db.Text
  preferredTone         String?
  contentStyle          String?  @db.Text
  mainCta               String?
  postingFrequency      String?
  preferredPlatforms    String[] @default([])
  marketingChallenges   String?  @db.Text
  monthlyBudget         String?
  teamSize              String?
  onboardingStep        Int      @default(0)
  onboardingCompletedAt DateTime?
  brand                 Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

/// Catalog of supported social platforms. OAuth providers plug in via ChannelConnection later.
model SocialChannel {
  id          String              @id @default(cuid())
  platform    ChannelPlatform     @unique
  name        String
  description String?
  connections ChannelConnection[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model ChannelConnection {
  id                String              @id @default(cuid())
  brandId           String
  socialChannelId   String
  status            ChannelStatus       @default(DISCONNECTED)
  health            ConnectionHealth    @default(PENDING)
  accountName       String?
  accountHandle     String?
  profilePictureUrl String?
  /// Reserved for real OAuth account id
  externalAccountId String?
  /// Non-sensitive provider metadata only (never plaintext tokens)
  providerMeta      Json?
  connectedAt       DateTime?
  lastSyncAt        DateTime?
  nextSyncAt        DateTime?
  lastError         String?
  brand             Brand               @relation(fields: [brandId], references: [id], onDelete: Cascade)
  socialChannel     SocialChannel       @relation(fields: [socialChannelId], references: [id], onDelete: Cascade)
  permissions       ChannelPermission[]
  conversations     Conversation[]
  connectedAccounts ConnectedAccount[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([brandId, socialChannelId])
  @@index([brandId])
  @@index([status])
  @@index([health])
}

model ChannelPermission {
  id           String            @id @default(cuid())
  connectionId String
  scope        String
  label        String
  granted      Boolean           @default(false)
  connection   ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([connectionId, scope])
  @@index([connectionId])
}

model KnowledgeDocument {
  id        String   @id @default(cuid())
  brandId   String
  title     String
  body      String   @default("") @db.Text
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId])
  @@index([brandId, title])
}

model ContentItem {
  id             String                 @id @default(cuid())
  brandId        String
  title          String
  body           String                 @default("") @db.Text
  description    String?                @db.Text
  objective      String?                @db.Text
  targetAudience String?                @db.Text
  notes          String?                @db.Text
  status         ContentStatus          @default(IDEAS)
  platform       ContentPlatform        @default(INSTAGRAM)
  format         ContentFormat          @default(INSTAGRAM_POST)
  priority       ContentPriority        @default(MEDIUM)
  campaignId     String?
  pillarId       String?
  assigneeId     String?
  dueDate        DateTime?
  scheduledAt    DateTime?
  publishedAt    DateTime?
  sortOrder      Int                    @default(0)
  deletedAt      DateTime?
  brand          Brand                  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  campaign       Campaign?              @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  pillar         ContentPillar?         @relation(fields: [pillarId], references: [id], onDelete: SetNull)
  assignee       User?                  @relation("ContentAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  brief          ContentBrief?
  checklist      ContentChecklistItem[]
  comments       ContentComment[]
  attachments    ContentAttachment[]
  calendarSlots  EditorialCalendar[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([brandId, status, sortOrder])
  @@index([brandId, campaignId])
  @@index([brandId, dueDate])
  @@index([brandId, scheduledAt])
  @@index([deletedAt])
}

model ContentBrief {
  id             String      @id @default(cuid())
  contentId      String      @unique
  goal           String?     @db.Text
  hook           String?     @db.Text
  problem        String?     @db.Text
  solution       String?     @db.Text
  cta            String?
  targetAudience String?     @db.Text
  references     String?     @db.Text
  keywords       String[]    @default([])
  hashtags       String[]    @default([])
  competitors    String?     @db.Text
  content        ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model ContentChecklistItem {
  id        String      @id @default(cuid())
  contentId String
  label     String
  done      Boolean     @default(false)
  sortOrder Int         @default(0)
  content   ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([contentId, sortOrder])
}

model ContentComment {
  id        String      @id @default(cuid())
  contentId String
  userId    String
  body      String      @db.Text
  mentions  String[]    @default([])
  deletedAt DateTime?
  content   ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([contentId, createdAt])
}

model ContentAttachment {
  id        String      @id @default(cuid())
  contentId String
  mediaId   String?
  label     String?
  url       String
  content   ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)
  media     MediaAsset? @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  createdAt DateTime    @default(now())

  @@index([contentId])
}

model ContentTemplate {
  id          String          @id @default(cuid())
  brandId     String
  name        String
  description String?
  category    String?
  format      ContentFormat   @default(INSTAGRAM_POST)
  platform    ContentPlatform @default(INSTAGRAM)
  titleHint   String?
  briefGoal   String?         @db.Text
  briefHook   String?         @db.Text
  checklist   String[]        @default([])
  archivedAt  DateTime?
  brand       Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([brandId, archivedAt])
}

model EditorialCalendar {
  id        String       @id @default(cuid())
  brandId   String
  contentId String?
  title     String
  date      DateTime
  note      String?
  content   ContentItem? @relation(fields: [contentId], references: [id], onDelete: SetNull)
  brand     Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([brandId, date])
}

model MediaAsset {
  id           String              @id @default(cuid())
  brandId      String
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  kind         String              @default("image")
  tags         String[]            @default([])
  folder       String?
  deletedAt    DateTime?
  brand        Brand               @relation(fields: [brandId], references: [id], onDelete: Cascade)
  attachments  ContentAttachment[]
  createdAt    DateTime            @default(now())

  @@index([brandId, folder])
  @@index([brandId, deletedAt])
}

model Campaign {
  id          String         @id @default(cuid())
  brandId     String
  name        String
  description String?        @db.Text
  objective   String?        @db.Text
  platforms   String[]       @default([])
  startDate   DateTime?
  endDate     DateTime?
  budget      String?
  status      CampaignStatus @default(PLANNING)
  color       String?        @default("#14b8a6")
  icon        String?
  archivedAt  DateTime?
  brand       Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  contents    ContentItem[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([brandId, status])
}

model Contact {
  id                String         @id @default(cuid())
  brandId           String
  name              String?
  instagramUsername String?
  phone             String?
  email             String?
  country           String?
  language          String?
  leadStatus        String?
  lifetimeValue     String?
  avatarUrl         String?
  joinedAt          DateTime?
  tags              String[]       @default([])
  notes             String?        @db.Text
  brand             Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  conversations     Conversation[]
  participants      ConversationParticipant[]
  internalNotes     InternalNote[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([brandId])
  @@index([brandId, instagramUsername])
}

model Conversation {
  id            String             @id @default(cuid())
  brandId       String
  contactId     String
  channelId     String?
  status        ConversationStatus @default(OPEN)
  isUnread      Boolean            @default(true)
  unreadCount   Int                @default(0)
  isStarred     Boolean            @default(false)
  assigneeId    String?
  subject       String?
  lastMessageAt DateTime           @default(now())
  brand         Brand              @relation(fields: [brandId], references: [id], onDelete: Cascade)
  contact       Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channel       ChannelConnection? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  assignee      User?              @relation("ConversationAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages      Message[]
  participants  ConversationParticipant[]
  events        ConversationEvent[]
  internalNotes InternalNote[]
  assignments   Assignment[]
  tagLinks      ConversationTag[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([brandId, status])
  @@index([brandId, isUnread])
  @@index([brandId, isStarred])
  @@index([brandId, lastMessageAt])
  @@index([contactId])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  contactId      String?
  userId         String?
  role           String       @default("customer")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model Message {
  id             String                @id @default(cuid())
  conversationId String
  body           String                @db.Text
  direction      MessageDirection
  kind           MessageKind           @default(TEXT)
  deliveryStatus MessageDeliveryStatus @default(SENT)
  isInternal     Boolean               @default(false)
  authorId       String?
  meta           Json?
  conversation   Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author         User?                 @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  attachments    MessageAttachment[]
  createdAt      DateTime              @default(now())

  @@index([conversationId, createdAt])
}

model MessageAttachment {
  id        String  @id @default(cuid())
  messageId String
  url       String
  filename  String?
  mimeType  String?
  kind      String  @default("file")
  size      Int?
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([messageId])
}

model InboxTag {
  id        String           @id @default(cuid())
  brandId   String
  name      String
  color     String?          @default("#14b8a6")
  brand     Brand            @relation(fields: [brandId], references: [id], onDelete: Cascade)
  links     ConversationTag[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([brandId, name])
  @@index([brandId])
}

model ConversationTag {
  id             String       @id @default(cuid())
  conversationId String
  tagId          String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tag            InboxTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([conversationId, tagId])
  @@index([tagId])
}

model SavedReply {
  id        String   @id @default(cuid())
  brandId   String
  title     String
  body      String   @db.Text
  category  String?
  shortcut  String?
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId, category])
  @@unique([brandId, shortcut])
}

model Assignment {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  assignedById   String?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation("AssignmentAssignee", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy     User?        @relation("AssignmentAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model InternalNote {
  id             String        @id @default(cuid())
  brandId        String
  conversationId String?
  contactId      String?
  userId         String
  body           String        @db.Text
  brand          Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  contact        Contact?      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([conversationId, createdAt])
  @@index([contactId, createdAt])
}

model ConversationEvent {
  id             String                @id @default(cuid())
  conversationId String
  type           ConversationEventType
  title          String
  meta           Json?
  userId         String?
  conversation   Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt      DateTime              @default(now())

  @@index([conversationId, createdAt])
}

enum NotificationType {
  SYSTEM
  WORKSPACE
  CHANNEL
  CONVERSATION
  CONTENT
  STRATEGY
}

enum ActivityKind {
  BUSINESS_UPDATED
  CHANNEL_CONNECTED
  CHANNEL_DISCONNECTED
  KNOWLEDGE_CREATED
  KNOWLEDGE_UPDATED
  CONTENT_CREATED
  CONTENT_UPDATED
  CONTACT_CREATED
  PERSONA_UPDATED
  STRATEGY_UPDATED
  FAVORITE_ADDED
  SYSTEM
}

enum EntityTargetType {
  PAGE
  KNOWLEDGE
  CONTACT
  CONTENT
  CHANNEL
  SETTINGS
}

model Notification {
  id          String           @id @default(cuid())
  workspaceId String
  userId      String
  type        NotificationType
  title       String
  body        String?
  href        String?
  readAt      DateTime?
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())

  @@index([userId, workspaceId, createdAt])
  @@index([userId, readAt])
}

model Activity {
  id          String       @id @default(cuid())
  workspaceId String
  brandId     String?
  userId      String?
  kind        ActivityKind
  title       String
  description String?
  href        String?
  meta        Json?
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User?        @relation("ActivityActor", fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())

  @@index([workspaceId, createdAt])
  @@index([brandId, createdAt])
}

model Favorite {
  id          String           @id @default(cuid())
  userId      String
  workspaceId String
  targetType  EntityTargetType
  targetId    String
  title       String
  href        String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())

  @@unique([userId, workspaceId, targetType, targetId])
  @@index([userId, workspaceId])
}

model RecentItem {
  id          String           @id @default(cuid())
  userId      String
  workspaceId String
  targetType  EntityTargetType
  targetId    String
  title       String
  href        String
  visitedAt   DateTime         @default(now())
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId, targetType, targetId])
  @@index([userId, workspaceId, visitedAt])
}

/// First-class Business Brain — structured knowledge for future AI (no LLM in this sprint).
model BusinessBrain {
  id                   String                 @id @default(cuid())
  brandId              String                 @unique
  currentQuestionKey   String?
  interviewStartedAt   DateTime?
  interviewCompletedAt DateTime?
  score                Int                    @default(0)
  completionPercent    Int                    @default(0)
  version              Int                    @default(1)
  deletedAt            DateTime?
  brand                Brand                  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  answers              BusinessAnswer[]
  voice                BrandVoice?
  assets               BrandAsset[]
  versions             BusinessBrainVersion[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([deletedAt])
}

model BusinessQuestion {
  id                String           @id @default(cuid())
  key               String           @unique
  groupKey          String
  sortOrder         Int              @default(0)
  prompt            String
  helpText          String?
  inputType         String
  options           String[]         @default([])
  estimatedSeconds  Int              @default(45)
  required          Boolean          @default(false)
  answers           BusinessAnswer[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([groupKey, sortOrder])
}

model BusinessAnswer {
  id         String           @id @default(cuid())
  brainId    String
  questionId String
  /// Plain text or JSON-serialized value (arrays, objects)
  value      String           @db.Text
  valueJson  Json?
  deletedAt  DateTime?
  brain      BusinessBrain    @relation(fields: [brainId], references: [id], onDelete: Cascade)
  question   BusinessQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([brainId, questionId])
  @@index([brainId, deletedAt])
}

model BrandVoice {
  id               String        @id @default(cuid())
  brainId          String        @unique
  traits           String[]      @default([])
  toneOfVoice      String?
  emojiUsage       String?
  writingStyle     String?
  ctaStyle         String?
  forbiddenWords   String[]      @default([])
  preferredWords   String[]      @default([])
  deletedAt        DateTime?
  brain            BusinessBrain @relation(fields: [brainId], references: [id], onDelete: Cascade)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model BrandAsset {
  id           String        @id @default(cuid())
  brainId      String
  kind         String
  label        String?
  url          String
  filename     String?
  originalName String?
  mimeType     String?
  size         Int?
  meta         Json?
  deletedAt    DateTime?
  brain        BusinessBrain @relation(fields: [brainId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([brainId, kind, deletedAt])
}

model BusinessBrainVersion {
  id          String        @id @default(cuid())
  brainId     String
  version     Int
  snapshot    Json
  note        String?
  createdAt   DateTime      @default(now())
  brain       BusinessBrain @relation(fields: [brainId], references: [id], onDelete: Cascade)

  @@unique([brainId, version])
  @@index([brainId, createdAt])
}

enum AutomationStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum AutomationNodeType {
  TRIGGER
  CONDITION
  ACTION
  DELAY
  BRANCH
  END
}

enum AutomationExecutionStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

/// Visual marketing automation — structure for future execution; no runtime engine yet.
model Automation {
  id             String            @id @default(cuid())
  brandId        String
  name           String
  description    String?           @db.Text
  category       String?
  status         AutomationStatus  @default(DRAFT)
  tags           String[]          @default([])
  version        Int               @default(1)
  nodeCount      Int               @default(0)
  executionCount Int               @default(0)
  createdById    String?
  brand          Brand             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdBy      User?             @relation("AutomationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  nodes          AutomationNode[]
  edges          AutomationEdge[]
  versions       AutomationVersion[]
  executions     AutomationExecution[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  archivedAt     DateTime?

  @@index([brandId, status])
  @@index([brandId, updatedAt])
  @@index([brandId, category])
}

model AutomationNode {
  id           String             @id @default(cuid())
  automationId String
  type         AutomationNodeType
  kind         String
  label        String
  description  String?
  config       Json               @default("{}")
  positionX    Float              @default(0)
  positionY    Float              @default(0)
  automation   Automation         @relation(fields: [automationId], references: [id], onDelete: Cascade)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([automationId])
}

model AutomationEdge {
  id           String     @id @default(cuid())
  automationId String
  sourceId     String
  targetId     String
  sourceHandle String?
  targetHandle String?
  label        String?
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@index([automationId])
}

model AutomationVersion {
  id           String     @id @default(cuid())
  automationId String
  version      Int
  snapshot     Json
  note         String?
  createdById  String?
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  createdBy    User?      @relation("AutomationVersionAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())

  @@unique([automationId, version])
  @@index([automationId, createdAt])
}

model AutomationExecution {
  id           String                     @id @default(cuid())
  automationId String
  status       AutomationExecutionStatus  @default(PENDING)
  meta         Json?
  startedAt    DateTime                   @default(now())
  finishedAt   DateTime?
  automation   Automation                 @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId, startedAt])
}

model AutomationTemplate {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?  @db.Text
  category    String?
  tags        String[] @default([])
  snapshot    Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Meta / social connected account — production integration layer.
model ConnectedAccount {
  id                String           @id @default(cuid())
  brandId           String
  connectionId      String?
  platform          ChannelPlatform
  /// instagram | facebook_pages | messenger
  product           String
  businessName      String?
  username          String?
  profilePictureUrl String?
  externalAccountId String?
  health            ConnectionHealth @default(PENDING)
  scopes            String[]         @default([])
  connectedAt       DateTime?
  lastSyncAt        DateTime?
  nextSyncAt        DateTime?
  lastError         String?
  providerMeta      Json?
  brand             Brand            @relation(fields: [brandId], references: [id], onDelete: Cascade)
  connection        ChannelConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  accessTokens      AccessToken[]
  refreshTokens     RefreshToken[]
  permissions       IntegrationPermission[]
  syncJobs          SyncJob[]
  syncHistory       SyncHistory[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  disconnectedAt    DateTime?

  @@index([brandId, platform])
  @@index([brandId, health])
  @@index([externalAccountId])
  @@index([connectionId])
}

model OAuthSession {
  id            String            @id @default(cuid())
  brandId       String
  userId        String
  platform      ChannelPlatform
  product       String
  /// CSRF state token (hashed at rest)
  stateHash     String
  /// Optional PKCE verifier (encrypted)
  codeVerifierCipher String?      @db.Text
  redirectUri   String
  status        OAuthSessionStatus @default(PENDING)
  scopes        String[]          @default([])
  expiresAt     DateTime
  consumedAt    DateTime?
  error         String?
  brand         Brand             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([stateHash])
  @@index([brandId, status])
  @@index([expiresAt])
}

model AccessToken {
  id                 String                @id @default(cuid())
  connectedAccountId String
  /// AES-GCM ciphertext (base64)
  ciphertext         String                @db.Text
  iv                 String
  authTag            String
  keyVersion         Int                   @default(1)
  expiresAt          DateTime?
  scopes             String[]              @default([])
  status             TokenCredentialStatus @default(ACTIVE)
  rotatedFromId      String?
  connectedAccount   ConnectedAccount      @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  revokedAt          DateTime?

  @@index([connectedAccountId, status])
  @@index([expiresAt])
}

model RefreshToken {
  id                 String                @id @default(cuid())
  connectedAccountId String
  ciphertext         String                @db.Text
  iv                 String
  authTag            String
  keyVersion         Int                   @default(1)
  expiresAt          DateTime?
  status             TokenCredentialStatus @default(ACTIVE)
  connectedAccount   ConnectedAccount      @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  revokedAt          DateTime?

  @@index([connectedAccountId, status])
}

model IntegrationPermission {
  id                 String           @id @default(cuid())
  connectedAccountId String
  scope              String
  label              String
  description        String?
  granted            Boolean          @default(false)
  required           Boolean          @default(true)
  connectedAccount   ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([connectedAccountId, scope])
  @@index([connectedAccountId])
}

model WebhookSubscription {
  id              String                    @id @default(cuid())
  brandId         String?
  platform        ChannelPlatform
  objectType      String
  fields          String[]                  @default([])
  callbackPath    String                    @default("/api/webhooks/meta")
  /// Hashed verify token — never store plaintext after creation response
  verifyTokenHash String?
  status          WebhookSubscriptionStatus @default(DRAFT)
  lastValidatedAt DateTime?
  meta            Json?
  brand           Brand?                    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([platform, status])
  @@index([brandId])
}

model SyncJob {
  id                 String           @id @default(cuid())
  brandId            String
  connectedAccountId String?
  jobType            String           @default("manual")
  status             SyncJobStatus    @default(QUEUED)
  progress           Int              @default(0)
  scheduledAt        DateTime         @default(now())
  startedAt          DateTime?
  finishedAt         DateTime?
  error              String?
  meta               Json?
  brand              Brand            @relation(fields: [brandId], references: [id], onDelete: Cascade)
  connectedAccount   ConnectedAccount? @relation(fields: [connectedAccountId], references: [id], onDelete: SetNull)
  history            SyncHistory[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([brandId, status])
  @@index([connectedAccountId, status])
  @@index([scheduledAt])
}

model SyncHistory {
  id                 String           @id @default(cuid())
  connectedAccountId String?
  syncJobId          String?
  status             SyncJobStatus
  message            String?
  error              String?
  meta               Json?
  connectedAccount   ConnectedAccount? @relation(fields: [connectedAccountId], references: [id], onDelete: SetNull)
  syncJob            SyncJob?         @relation(fields: [syncJobId], references: [id], onDelete: SetNull)
  createdAt          DateTime         @default(now())

  @@index([connectedAccountId, createdAt])
  @@index([syncJobId])
}

model IntegrationAuditLog {
  id        String               @id @default(cuid())
  brandId   String?
  userId    String?
  kind      IntegrationAuditKind
  message   String
  meta      Json?
  ip        String?
  userAgent String?
  brand     Brand?               @relation(fields: [brandId], references: [id], onDelete: SetNull)
  user      User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime             @default(now())

  @@index([brandId, createdAt])
  @@index([kind, createdAt])
}

/// Catalog of analytics metric definitions — ready for Meta/provider ingestion later.
model Metric {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  category    String
  unit        String   @default("count")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AnalyticsSnapshot {
  id          String   @id @default(cuid())
  brandId     String
  date        DateTime @db.Date
  granularity String   @default("day")
  source      String   @default("mock")
  /// Time-series metric bag: { followers, reach, impressions, ... }
  values      Json
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([brandId, date, granularity, source])
  @@index([brandId, date])
}

model Kpi {
  id            String   @id @default(cuid())
  brandId       String
  metricKey     String
  label         String
  currentValue  Float
  previousValue Float
  changePct     Float
  sparkline     Float[]  @default([])
  unit          String   @default("count")
  sortOrder     Int      @default(0)
  brand         Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([brandId, metricKey])
  @@index([brandId, sortOrder])
}

model AudienceSnapshot {
  id         String   @id @default(cuid())
  brandId    String
  date       DateTime @db.Date
  locations  Json
  ages       Json
  genders    Json
  languages  Json
  activeHours Json
  devices    Json
  brand      Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([brandId, date])
  @@index([brandId, date])
}

model ContentMetric {
  id            String   @id @default(cuid())
  brandId       String
  externalId    String
  title         String
  platform      String
  contentType   String
  author        String?
  status        String   @default("published")
  publishedAt   DateTime
  reach         Int      @default(0)
  likes         Int      @default(0)
  comments      Int      @default(0)
  shares        Int      @default(0)
  saves         Int      @default(0)
  impressions   Int      @default(0)
  ctr           Float    @default(0)
  engagement    Int      @default(0)
  brand         Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([brandId, externalId])
  @@index([brandId, publishedAt])
  @@index([brandId, platform])
  @@index([brandId, contentType])
}

model CampaignMetric {
  id           String   @id @default(cuid())
  brandId      String
  campaignKey  String
  name         String
  status       String   @default("active")
  reach        Int      @default(0)
  engagement   Int      @default(0)
  clicks       Int      @default(0)
  conversions  Int      @default(0)
  spend        Float    @default(0)
  revenue      Float    @default(0)
  roi          Float    @default(0)
  brand        Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([brandId, campaignKey])
  @@index([brandId])
}

model ChannelMetric {
  id           String   @id @default(cuid())
  brandId      String
  platform     String
  date         DateTime @db.Date
  followers    Int      @default(0)
  reach        Int      @default(0)
  impressions  Int      @default(0)
  engagement   Int      @default(0)
  messages     Int      @default(0)
  profileVisits Int     @default(0)
  brand        Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([brandId, platform, date])
  @@index([brandId, platform, date])
}

model Insight {
  id          String   @id @default(cuid())
  brandId     String
  kind        String
  severity    String   @default("info")
  title       String
  body        String   @db.Text
  metricKey   String?
  changePct   Float?
  ruleKey     String
  rangeStart  DateTime?
  rangeEnd    DateTime?
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([brandId, createdAt])
  @@index([brandId, kind])
}

model ReportTemplate {
  id          String   @id @default(cuid())
  brandId     String
  name        String
  description String?
  metrics     String[] @default([])
  charts      String[] @default([])
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  reports     Report[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([brandId])
}

model Report {
  id          String   @id @default(cuid())
  brandId     String
  templateId  String?
  name        String
  rangeLabel  String?
  metrics     String[] @default([])
  charts      String[] @default([])
  payload     Json?
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  template    ReportTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([brandId, createdAt])
}




