  LOCAL
  WEATHER_SEASON
  SCHOOL_CALENDAR
  SHOPPING
  CUSTOM
}

enum EventRecurrence {
  ONE_TIME
  ANNUAL
  MONTHLY
  WEEKLY
  CUSTOM
}

enum EventImportance {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CalendarEventStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum EventVerificationStatus {
  OFFICIAL
  VERIFIED
  COMMUNITY_VERIFIED
  DRAFT
  ARCHIVED
}

enum ImportJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ImportFormat {
  CSV
  EXCEL
  JSON
  ICS
  REST
}

enum OpportunityStatus {
  NEW
  SAVED
  DISMISSED
  ACTED
  MISSED
  IGNORED
  EXPIRED
}

enum OpportunityMatchSource {
  DETERMINISTIC
  AI
  MANUAL
}

enum OpportunityOverrideKind {
  FORCE_MATCH
  IGNORE_EVENT
  PIN
  PRIORITY
  BLACKLIST
  WHITELIST
}

enum OpportunityConflictKind {
  COMPETING_CAMPAIGN
  SCHEDULE_COLLISION
  DUPLICATE_OPPORTUNITY
  EXPIRED_PREPARATION
  RESOURCE_CONFLICT
}

enum OpportunityPlanningMode {
  AUTO
  GUIDED
  MANUAL
}

enum OpportunityAlertOffset {
  DAYS_30
  DAYS_14
  DAYS_7
  DAYS_3
  DAYS_1
  DAY_OF
}

enum OpportunityFeedbackAction {
  ACCEPTED
  REJECTED
  SAVED
  DISMISSED
  ACTED
}

model MarketingSource {
  id               String                         @id @default(cuid())
  key              String                         @unique
  name             String
  description      String?
  events           MarketingEvent[]               @relation("EventPrimarySource")
  secondaryEvents  MarketingEventSecondarySource[]
  createdAt        DateTime                       @default(now())
  updatedAt        DateTime                       @updatedAt
}

model MarketingCategory {
  id          String              @id @default(cuid())
  key         String              @unique
  name        String
  description String?
  parentId    String?
  sortOrder   Int                 @default(0)
  parent      MarketingCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    MarketingCategory[] @relation("CategoryTree")
  events      MarketingEvent[]    @relation("EventPrimaryCategory")
  subEvents   MarketingEvent[]    @relation("EventSubcategory")
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([parentId, sortOrder])
}

model MarketingRegion {
  id        String             @id @default(cuid())
  key       String             @unique
  name      String
  kind      String             @default("REGION")
  parentId  String?
  parent    MarketingRegion?   @relation("RegionTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  MarketingRegion[]  @relation("RegionTree")
  countries MarketingCountry[]
  events    MarketingEvent[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([parentId])
}

model MarketingCountry {
  id        String                   @id @default(cuid())
  code      String                   @unique
  name      String
  regionId  String?
  region    MarketingRegion?         @relation(fields: [regionId], references: [id], onDelete: SetNull)
  events    MarketingEventCountry[]
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  @@index([regionId])
}

model MarketingTag {
  id        String              @id @default(cuid())
  key       String              @unique
  name      String
  events    MarketingEventTag[]
  createdAt DateTime            @default(now())

  @@index([name])
}

model OpportunityCategory {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String?
  sortOrder   Int              @default(0)
  events      MarketingEvent[] @relation("OpportunityEventCategory")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model MarketingEvent {
  id                  String                @id @default(cuid())
  key                 String                @unique
  /// Canonical title (original language)
  name                String
  title               String?
  description         String?               @db.Text
  source              MarketingEventSource
  sourceId            String?
  categoryId          String?
  marketingCategoryId String?
  subcategoryId       String?
  regionId            String?
  state               String?
  province            String?
  city                String?
  language            String                @default("en")
  timezone            String                @default("UTC")
  /// Annual recurrence helpers (1-12 / 1-31). Null for non-annual.
  month               Int?
  day                 Int?
  /// 1-4 derived from month when set
  quarter             Int?
  startDate           DateTime?             @db.Date
  endDate             DateTime?             @db.Date
  recurrence          EventRecurrence       @default(ANNUAL)
  recurrenceRule      String?
  importance          EventImportance       @default(MEDIUM)
  status              CalendarEventStatus   @default(ACTIVE)
  verificationStatus  EventVerificationStatus @default(DRAFT)
  /// Legacy flag — mirrored from status for Opportunity Engine
  active              Boolean               @default(true)
  version             Int                   @default(1)
  importedAt          DateTime?
  lastVerifiedAt      DateTime?
  /// Denormalized keyword index for fast search
  searchText          String?               @db.Text
  countries           String[]              @default([])
  industries          String[]              @default([])
  tags                String[]              @default([])
  audienceHints       String[]              @default([])
  sourceRef           MarketingSource?      @relation("EventPrimarySource", fields: [sourceId], references: [id], onDelete: SetNull)
  category            OpportunityCategory?  @relation("OpportunityEventCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  marketingCategory   MarketingCategory?    @relation("EventPrimaryCategory", fields: [marketingCategoryId], references: [id], onDelete: SetNull)
  subcategory         MarketingCategory?    @relation("EventSubcategory", fields: [subcategoryId], references: [id], onDelete: SetNull)
  region              MarketingRegion?      @relation(fields: [regionId], references: [id], onDelete: SetNull)
  countryLinks        MarketingEventCountry[]
  tagLinks            MarketingEventTag[]
  secondarySources    MarketingEventSecondarySource[]
  translations        MarketingTranslation[]
  localizations       MarketingLocalization[]
  seasons             MarketingEventSeason[]
  versions            MarketingEventVersion[]
  history             MarketingEventHistory[]
  verifications       MarketingVerification[]
  knowledgeLinks      MarketingEventKnowledge[]
  opportunityOverrides OpportunityOverride[]
  /// Preparation windows for deterministic planning (days before event)
  preparationDays     Int?
  planningWindowDays  Int?
  publishingWindowDays Int?
  reminderOffsets     Int[]                 @default([])
  expirationDays      Int?
  opportunities       BusinessOpportunity[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([source, active])
  @@index([status, importance])
  @@index([verificationStatus, status])
  @@index([month, day])
  @@index([quarter, month])
  @@index([startDate, endDate])
  @@index([recurrence, month, day])
  @@index([categoryId])
  @@index([marketingCategoryId, status])
  @@index([regionId])
  @@index([language])
  @@index([name])
  @@index([city])
  @@index([version])
}

model MarketingEventCountry {
  eventId   String
  countryId String
  event     MarketingEvent   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  country   MarketingCountry @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@id([eventId, countryId])
  @@index([countryId])
}

model MarketingEventTag {
  eventId String
  tagId   String
  event   MarketingEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tag     MarketingTag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([eventId, tagId])
  @@index([tagId])
}

model MarketingEventSecondarySource {
  eventId  String
  sourceId String
  event    MarketingEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  source   MarketingSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([eventId, sourceId])
  @@index([sourceId])
}

model MarketingTranslation {
  id            String         @id @default(cuid())
  eventId       String
  language      String
  title         String
  description   String?        @db.Text
  slug          String?
  keywords      String[]       @default([])
  seoTitle      String?
  seoDescription String?       @db.Text
  event         MarketingEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([eventId, language])
  @@index([language, title])
  @@index([slug])
}

/// EPIC-022 — richer localization layer (keeps MarketingTranslation in sync)
model MarketingLocalization {
  id             String         @id @default(cuid())
  eventId        String
  language       String
  title          String
  description    String?        @db.Text
  slug           String?
  keywords       String[]       @default([])
  seoTitle       String?
  seoDescription String?        @db.Text
  seoKeywords    String[]       @default([])
  event          MarketingEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([eventId, language])
  @@index([language, title])
  @@index([slug])
}

model MarketingSeason {
  id         String                @id @default(cuid())
  key        String                @unique
  name       String
  kind       String
  startMonth Int?
  startDay   Int?
  endMonth   Int?
  endDay     Int?
  hemisphere String?
  events     MarketingEventSeason[]
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@index([kind])
}

model MarketingEventSeason {
  eventId  String
  seasonId String
  event    MarketingEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  season   MarketingSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@id([eventId, seasonId])
  @@index([seasonId])
}

model MarketingEventVersion {
  id        String         @id @default(cuid())
  eventId   String
  version   Int
  snapshot  Json
  note      String?
  event     MarketingEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([eventId, version])
  @@index([eventId, createdAt])
}

model MarketingEventHistory {
  id        String         @id @default(cuid())
  eventId   String
  action    String
  message   String
  meta      Json?
  actorId   String?
  event     MarketingEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@index([eventId, createdAt])
  @@index([action])
}

model MarketingVerification {
  id         String                  @id @default(cuid())
  eventId    String
  status     EventVerificationStatus
  note       String?
  verifiedAt DateTime                @default(now())
  verifiedBy String?
  event      MarketingEvent          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt  DateTime                @default(now())

  @@index([eventId, verifiedAt])
  @@index([status])
}

model MarketingImportJob {
  id        String          @id @default(cuid())
  format    ImportFormat
  status    ImportJobStatus @default(PENDING)
  fileName  String?
  sourceUrl String?
  total     Int             @default(0)
  success   Int             @default(0)
  failed    Int             @default(0)
  meta      Json?
  logs      MarketingImportLog[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([status, createdAt])
  @@index([format])
}

model MarketingImportLog {
  id        String             @id @default(cuid())
  jobId     String
  level     String             @default("info")
  message   String
  row       Int?
  meta      Json?
  job       MarketingImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now())

  @@index([jobId, createdAt])
}

/// EPIC-023 — Marketing Knowledge Graph (no AI; structured relationships only)

enum KnowledgeStrength {
  VERY_WEAK
  WEAK
  MEDIUM
  STRONG
  VERY_STRONG
}

enum KnowledgeNodeKind {
  INDUSTRY
  BUSINESS_TYPE
  PRODUCT_CATEGORY
  AUDIENCE
  CAMPAIGN_TYPE
  OBJECTIVE
  CONTENT_TYPE
  CHANNEL
  CTA
  EMOTIONAL_TONE
  SEASON
  CUSTOM
}

model Industry {
  id            String         @id @default(cuid())
  key           String         @unique
  name          String
  description   String?
  businessTypes BusinessType[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model BusinessType {
  id         String         @id @default(cuid())
  key        String         @unique
  name       String
  industryId String?
  parentId   String?
  industry   Industry?      @relation(fields: [industryId], references: [id], onDelete: SetNull)
  parent     BusinessType?  @relation("BusinessTypeTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   BusinessType[] @relation("BusinessTypeTree")
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([industryId, parentId])
}

model ProductCategory {
  id          String            @id @default(cuid())
  key         String            @unique
  name        String
  kind        String            @default("CATEGORY")
  parentId    String?
  description String?
  parent      ProductCategory?  @relation("ProductCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    ProductCategory[] @relation("ProductCategoryTree")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([parentId, kind])
}

model Audience {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CampaignType {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MarketingObjective {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContentType {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DistributionChannel {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CTA {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EmotionalTone {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model KnowledgeRelationType {
  id          String              @id @default(cuid())
  key         String              @unique
  name        String
  description String?
  relations   KnowledgeRelation[]
  eventLinks  MarketingEventKnowledge[]
  createdAt   DateTime            @default(now())
}

model KnowledgeNode {
  id          String              @id @default(cuid())
  kind        KnowledgeNodeKind
  key         String
  name        String
  description String?
  parentId    String?
  meta        Json?
  active      Boolean             @default(true)
  parent      KnowledgeNode?      @relation("KnowledgeNodeTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    KnowledgeNode[]     @relation("KnowledgeNodeTree")
  fromRels    KnowledgeRelation[] @relation("KnowledgeFrom")
  toRels      KnowledgeRelation[] @relation("KnowledgeTo")
  eventLinks  MarketingEventKnowledge[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([kind, key])
  @@index([kind, name])
  @@index([parentId])
  @@index([active])
}

model KnowledgeRelation {
  id        String                 @id @default(cuid())
  fromNodeId String
  toNodeId  String
  typeId    String
  strength  KnowledgeStrength      @default(MEDIUM)
  note      String?
  fromNode  KnowledgeNode          @relation("KnowledgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode    KnowledgeNode          @relation("KnowledgeTo", fields: [toNodeId], references: [id], onDelete: Cascade)
  type      KnowledgeRelationType  @relation(fields: [typeId], references: [id], onDelete: Cascade)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@unique([fromNodeId, toNodeId, typeId])
  @@index([toNodeId])
  @@index([typeId, strength])
}

model MarketingEventKnowledge {
  eventId   String
  nodeId    String
  typeId    String?
  strength  KnowledgeStrength     @default(MEDIUM)
  note      String?
  event     MarketingEvent        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  node      KnowledgeNode         @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  type      KnowledgeRelationType? @relation(fields: [typeId], references: [id], onDelete: SetNull)
  createdAt DateTime              @default(now())

  @@id([eventId, nodeId])
  @@index([nodeId])
  @@index([typeId, strength])
}

model BusinessOpportunity {
  id            String                   @id @default(cuid())
  workspaceId   String
  brandId       String
  eventId       String
  title         String
  summary       String                   @db.Text
  matchReason   String                   @db.Text
  eventDate     DateTime                 @db.Date
  status        OpportunityStatus        @default(NEW)
  planningMode  OpportunityPlanningMode  @default(AUTO)
  constraints   Json?
  impactTier    String                   @default("medium")
  /// EPIC-024 deterministic matching
  matchSource   OpportunityMatchSource   @default(DETERMINISTIC)
  scoreLevel    String?
  confidence    Float?
  whyMatched    String?                  @db.Text
  rulesMatched  String[]                 @default([])
  rulesFailed   String[]                 @default([])
  missingInfo   String[]                 @default([])
  planningStart DateTime?
  contentDeadline DateTime?
  designDeadline DateTime?
  approvalDeadline DateTime?
  publishingStart DateTime?
  publishingEnd DateTime?
  expirationAt  DateTime?
  pinned        Boolean                  @default(false)
  ignored       Boolean                  @default(false)
  priorityOverride Int?
  workspace     Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand         Brand                    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  event         MarketingEvent           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  score         OpportunityScore?
  recommendations OpportunityRecommendation[]
  alerts        OpportunityAlert[]
  feedback      OpportunityFeedback[]
  evidence      OpportunityEvidence[]
  history       OpportunityHistory[]
  conflicts     OpportunityConflict[]
  campaignRecommendations CampaignRecommendation[]
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@unique([brandId, eventId, eventDate])
  @@index([brandId, status, eventDate])
  @@index([workspaceId, eventDate])
  @@index([brandId, matchSource, scoreLevel])
  @@index([brandId, pinned, ignored])
}

model OpportunityScore {
  id                     String              @id @default(cuid())
  opportunityId          String              @unique
  relevance              Float               @default(0)
  urgency                Float               @default(0)
  expectedReach          Float               @default(0)
  salesPotential         Float               @default(0)
  engagementPotential    Float               @default(0)
  difficulty             Float               @default(0)
  confidence             Float               @default(0)
  overall                Float               @default(0)
  industryScore          Float               @default(0)
  audienceScore          Float               @default(0)
  productScore           Float               @default(0)
  goalScore              Float               @default(0)
  seasonScore            Float               @default(0)
  locationScore          Float               @default(0)
  channelScore           Float               @default(0)
  preparationScore       Float               @default(0)
  brandCompatibilityScore Float              @default(0)
  explanation            String              @db.Text
  opportunity            BusinessOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
}

model OpportunityEvidence {
  id            String              @id @default(cuid())
  opportunityId String
  ruleKey       String
  passed        Boolean
  detail        String              @db.Text
  weight        Float               @default(0)
  contribution  Float               @default(0)
  opportunity   BusinessOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  createdAt     DateTime            @default(now())

  @@index([opportunityId, ruleKey])
}

model OpportunityRule {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  weight      Float
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OpportunityHistory {
  id            String              @id @default(cuid())
  opportunityId String?
  brandId       String
  eventId       String?
  action        String
  message       String
  meta          Json?
  opportunity   BusinessOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  createdAt     DateTime            @default(now())

  @@index([brandId, createdAt])
  @@index([opportunityId, createdAt])
}

model OpportunityOverride {
  id        String                  @id @default(cuid())
  brandId   String
  eventId   String?
  kind      OpportunityOverrideKind
  priority  Int?
  note      String?
  active    Boolean                 @default(true)
  brand     Brand                   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  event     MarketingEvent?         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  @@index([brandId, kind, active])
  @@index([eventId])
}

model OpportunityConflict {
  id            String                 @id @default(cuid())
  opportunityId String
  kind          OpportunityConflictKind
  title         String
  detail        String                 @db.Text
  resolved      Boolean                @default(false)
  opportunity   BusinessOpportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  createdAt     DateTime               @default(now())

  @@index([opportunityId, resolved])
  @@index([kind])
}

model OpportunityRecommendation {
  id            String              @id @default(cuid())
  opportunityId String
  kind          String
  title         String
  detail        String              @db.Text
  sortOrder     Int                 @default(0)
  opportunity   BusinessOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  createdAt     DateTime            @default(now())

  @@index([opportunityId, sortOrder])
}

model OpportunityAlert {
  id            String                 @id @default(cuid())
  opportunityId String
  offset        OpportunityAlertOffset
  notifyAt      DateTime
  sentAt        DateTime?
  dismissedAt   DateTime?
  opportunity   BusinessOpportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  createdAt     DateTime               @default(now())

  @@unique([opportunityId, offset])
  @@index([notifyAt, sentAt])
}

model OpportunityFeedback {
  id            String                     @id @default(cuid())
  brandId       String
  opportunityId String?
  userId        String?
  action        OpportunityFeedbackAction
  note          String?
  meta          Json?
  brand         Brand                      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  opportunity   BusinessOpportunity?       @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  user          User?                      @relation("OpportunityFeedbackAuthor", fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime                   @default(now())

  @@index([brandId, action, createdAt])
  @@index([opportunityId])
}

/// EPIC-025 — Campaign Recommendation Engine

enum CampaignRecStatus {
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
  SENT_TO_PLANNER
}

enum CampaignStrategyKind {
  AWARENESS
  SALES
  RETENTION
  LAUNCH
  PROMOTION
  COMMUNITY
  EDUCATION
  BRANDING
  REFERRAL
  SEASONAL
}

enum CampaignScenarioKind {
  CONSERVATIVE
  BALANCED
  AGGRESSIVE
}

enum CampaignLearningOutcome {
  ACCEPTED
  REJECTED
  MODIFIED
  RESULT_RECORDED
}

model CampaignRecommendation {
  id                       String               @id @default(cuid())
  workspaceId              String
  brandId                  String
  opportunityId            String
  campaignId               String?
  contentPlanId            String?
  name                     String
  objective                String               @db.Text
  strategy                 CampaignStrategyKind @default(AWARENESS)
  targetAudience           String               @db.Text
  primaryChannel           String
  supportingChannels       String[]             @default([])
  suggestedDurationDays    Int                  @default(14)
  priority                 Float                @default(50)
  confidence               Float                @default(0.7)
  status                   CampaignRecStatus    @default(PENDING)
  /// Structured directions only — never final marketing copy or images
  suggestedOffer           String?              @db.Text
  suggestedTheme           String?              @db.Text
  suggestedVisualDirection String?              @db.Text
  suggestedMessaging       String?              @db.Text
  suggestedCta             String?              @db.Text
  suggestedLandingPage     String?              @db.Text
  suggestedEmail           String?              @db.Text
  suggestedStorySequence   Json?
  suggestedReelSeries      Json?
  suggestedCarouselSeries  Json?
  contentPlan              Json?
  whyThisCampaign          String               @db.Text
  whyNow                   String               @db.Text
  supportingEvidence       Json?
  tradeOffs                String?              @db.Text
  potentialRisks           String?              @db.Text
  complexity               String               @default("medium")
  requiredTeam             String[]             @default([])
  estimatedHours           Float?
  assetsNeeded             String[]             @default([])
  riskLevel                String               @default("medium")
  explanation              String               @db.Text
  eligibleOverride         Boolean              @default(false)
  sortOrder                Int                  @default(0)
  workspace                Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand                    Brand                @relation(fields: [brandId], references: [id], onDelete: Cascade)
  opportunity              BusinessOpportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  campaign                 Campaign?            @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  scenarios                CampaignScenario[]
  executionPlan            CampaignExecutionPlan?
  impactEstimate           CampaignImpactEstimate?
  learnings                CampaignLearning[]
  workflow                 CampaignWorkflow?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  @@index([brandId, status, priority])
  @@index([opportunityId, status])
  @@index([workspaceId, createdAt])
}

model CampaignScenario {
  id               String               @id @default(cuid())
  recommendationId String
  kind             CampaignScenarioKind
  name             String
  summary          String               @db.Text
  priority         Float                @default(50)
  confidence       Float                @default(0.7)
  adjustments      Json?
  selected         Boolean              @default(false)
  recommendation   CampaignRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([recommendationId, kind])
  @@index([recommendationId, selected])
}

model CampaignExecutionPlan {
  id               String                 @id @default(cuid())
  recommendationId String                 @unique
  preparation      String?                @db.Text
  design           String?                @db.Text
  approval         String?                @db.Text
  publishing       String?                @db.Text
  followUp         String?                @db.Text
  measurement      String?                @db.Text
  steps            Json?
  recommendation   CampaignRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
}

model CampaignImpactEstimate {
  id                    String                 @id @default(cuid())
  recommendationId      String                 @unique
  expectedReach         Float                  @default(0)
  expectedEngagement    Float                  @default(0)
  expectedLeads         Float                  @default(0)
  expectedRevenueImpact Float                  @default(0)
  brandImpact           Float                  @default(0)
  confidence            Float                  @default(0.7)
  notes                 String?                @db.Text
  recommendation        CampaignRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

model CampaignLearning {
  id               String                   @id @default(cuid())
  brandId          String
  recommendationId String?
  outcome          CampaignLearningOutcome
  note             String?
  meta             Json?
  brand            Brand                    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  recommendation   CampaignRecommendation?  @relation(fields: [recommendationId], references: [id], onDelete: SetNull)
  createdAt        DateTime                 @default(now())

  @@index([brandId, outcome, createdAt])
  @@index([recommendationId])
}

/// EPIC-026 — Planner Integration & Execution Pipeline

enum WorkflowStatus {
  DRAFT
  PLANNING
  READY
  IN_PROGRESS
  WAITING_APPROVAL
  SCHEDULED
  PUBLISHED
  COMPLETED
  ARCHIVED
}

enum WorkflowTimelineKind {
  PLANNING
  PUBLISHING
  REVIEW
  APPROVAL
  REMINDER
}

enum WorkflowDependencyKind {
  TASK
  CONTENT
  CAMPAIGN
  APPROVAL
}

model CampaignWorkflow {
  id                String                @id @default(cuid())
  workspaceId       String
  brandId           String
  recommendationId  String?               @unique
  campaignId        String?
  contentPlanId     String?
  projectId         String?
  opportunityId     String?
  title             String
  status            WorkflowStatus        @default(DRAFT)
  priority          Float                 @default(50)
  /// Anchor publish / event date
  anchorDate        DateTime              @db.Date
  planningStart     DateTime?
  reviewAt          DateTime?
  approvalAt        DateTime?
  publishingStart   DateTime?
  publishingEnd     DateTime?
  /// Snapshot of business context — never drop on handoff
  context           Json
  reversible        Boolean               @default(true)
  archivedAt        DateTime?
  workspace         Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand             Brand                 @relation(fields: [brandId], references: [id], onDelete: Cascade)
  recommendation    CampaignRecommendation? @relation(fields: [recommendationId], references: [id], onDelete: SetNull)
  campaign          Campaign?             @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  project           MarketingProject?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  handoffs          PlannerHandoff[]
  timelines         WorkflowTimeline[]
  dependencies      WorkflowDependency[]
  audits            WorkflowAudit[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([brandId, status, anchorDate])
  @@index([workspaceId, createdAt])
  @@index([campaignId])
  @@index([projectId])
}

model PlannerHandoff {
  id            String           @id @default(cuid())
  workflowId    String
  contentPlanId String?
  /// Transferred objective, audience, requirements, channels, timeline, priority, brand DNA
  payload       Json
  createdById   String?
  workflow      CampaignWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  createdBy     User?            @relation("PlannerHandoffActor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime         @default(now())

  @@index([workflowId, createdAt])
}

model WorkflowTimeline {
  id          String               @id @default(cuid())
  workflowId  String
  kind        WorkflowTimelineKind
  title       String
  dueAt       DateTime
  milestoneId String?
  offsetDays  Int                  @default(0)
  meta        Json?
  workflow    CampaignWorkflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([workflowId, kind, title])
  @@index([workflowId, dueAt])
  @@index([kind, dueAt])
}

model WorkflowDependency {
  id         String                 @id @default(cuid())
  workflowId String
  kind       WorkflowDependencyKind
  fromKey    String
  toKey      String
  fromTaskId String?
  toTaskId   String?
  note       String?
  workflow   CampaignWorkflow       @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  createdAt  DateTime               @default(now())

  @@unique([workflowId, kind, fromKey, toKey])
  @@index([workflowId, kind])
}

model WorkflowAudit {
  id         String           @id @default(cuid())
  workflowId String
  actorId    String?
  action     String
  message    String
  before     Json?
  after      Json?
  workflow   CampaignWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  actor      User?            @relation("WorkflowAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime         @default(now())

  @@index([workflowId, createdAt])
  @@index([actorId, createdAt])
}

/// EPIC-018 — AI Community Manager

enum CommunityResponseMode {
  MANUAL
  APPROVAL_REQUIRED
  SEMI_AUTOMATIC
  AUTOMATIC
}

enum CommunityTone {
  PROFESSIONAL
  FRIENDLY
  LUXURY
  MINIMAL
  CORPORATE
  FUNNY
  YOUTH
  PREMIUM
  EDUCATIONAL
}

enum ConversationIntentType {
  QUESTION
  COMPLAINT
  SALES_LEAD
  SUPPORT
  COMPLIMENT
  SPAM
  VIP
  RETURNING
  INFLUENCER
  OTHER
}

enum SuggestedReplyKind {
  REPLY
  FOLLOW_UP
  OFFER
  DISCOUNT
  CTA
  KNOWLEDGE
  ESCALATE
}

enum SuggestedReplyStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  EDITED
  REJECTED
  SENT
  AUTO_QUEUED
}

model CommunityRule {
  id             String                @id @default(cuid())
  workspaceId    String
  brandId        String
  responseMode   CommunityResponseMode @default(APPROVAL_REQUIRED)
  tone           CommunityTone         @default(FRIENDLY)
  enabled        Boolean               @default(true)
  autoCategories String[]              @default([])
  settings       Json?
  workspace      Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand          Brand                 @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([brandId])
  @@index([workspaceId])
}

model AutoReplyRule {
  id          String                @id @default(cuid())
  brandId     String
  name        String
  intentType  ConversationIntentType
  enabled     Boolean               @default(false)
  /// Never auto-send unless CommunityRule.responseMode allows and this is true
  autoSend    Boolean               @default(false)
  template    String?               @db.Text
  conditions  Json?
  brand       Brand                 @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([brandId, enabled])
  @@unique([brandId, intentType, name])
}

model ConversationIntent {
  id             String                 @id @default(cuid())
  conversationId String                 @unique
  type           ConversationIntentType @default(OTHER)
  confidence     Float                  @default(0.5)
  labels         String[]               @default([])
  explanation    String?                @db.Text
  conversation   Conversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
}

model ConversationPriority {
  id             String       @id @default(cuid())
  conversationId String       @unique
  score          Float        @default(50)
  rankReason     String       @db.Text
  vip            Boolean      @default(false)
  urgent         Boolean      @default(false)
  revenuePotential Float      @default(0)
  unanswered     Boolean      @default(false)
  negativeSentiment Boolean   @default(false)
  agingHours     Float        @default(0)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([score])
}

model SentimentAnalysis {
  id             String       @id @default(cuid())
  conversationId String       @unique
  label          String
  score          Float
  buyingIntent   Float        @default(0)
  urgency        Float        @default(0)
  satisfaction   Float        @default(50)
  spamProbability Float       @default(0)
  salesOpportunity Float      @default(0)
  retentionRisk  Float        @default(0)
  explanation    String?      @db.Text
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model SuggestedReply {
  id               String               @id @default(cuid())
  brandId          String
  conversationId   String
  kind             SuggestedReplyKind   @default(REPLY)
  status           SuggestedReplyStatus @default(DRAFT)
  body             String               @db.Text
  tone             CommunityTone        @default(FRIENDLY)
  confidence       Float                @default(0.7)
  qualityScore     Float?
  qualityBreakdown Json?
  explanation      String?              @db.Text
  editedBody       String?              @db.Text
  reviewedById     String?
  reviewedAt       DateTime?
  brand            Brand                @relation(fields: [brandId], references: [id], onDelete: Cascade)
  conversation     Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  reviewedBy       User?                @relation("SuggestedReplyReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([brandId, status, createdAt])
  @@index([conversationId, createdAt])
}

model CustomerProfile {
  id               String   @id @default(cuid())
  brandId          String
  contactId        String   @unique
  isVip            Boolean  @default(false)
  isInfluencer     Boolean  @default(false)
  isReturning      Boolean  @default(false)
  lifetimeValue    Float?
  favoriteProducts String[] @default([])
  tags             String[] @default([])
  summary          String?  @db.Text
  meta             Json?
  brand            Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  contact          Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([brandId, isVip])
}

model ConversationMemory {
  id             String        @id @default(cuid())
  conversationId String?
  contactId      String
  key            String
  content        String        @db.Text
  meta           Json?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  contact        Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([contactId, key])
  @@index([conversationId])
}

/// EPIC-019 — AI Marketing Decision Center

enum ExecutiveBriefKind {
  DAILY
  MORNING
}

enum DecisionType {
  INCREASE_BUDGET
  PAUSE_CAMPAIGN
  PUBLISH_EARLIER
  DELAY_CAMPAIGN
  CREATE_PROMOTION
  LAUNCH_GIVEAWAY
  ANSWER_VIP
  BOOST_CONTENT
  ARCHIVE_CONTENT
  UPDATE_LANDING_PAGE
  RUN_AB_TEST
  CREATE_REEL
  PUBLISH_STORY
  OTHER
}

enum DecisionStatus {
  PENDING
  APPROVED
  REJECTED
  POSTPONED
  ASSIGNED
  COMPLETED
}

enum DecisionActionType {
  APPROVE
  REJECT
  POSTPONE
  ASSIGN
  CONVERT_CAMPAIGN
  GENERATE_CONTENT
  GENERATE_BRIEF
  SCHEDULE
  CREATE_TASK
}

model ExecutiveBrief {
  id                 String             @id @default(cuid())
  workspaceId        String
  brandId            String
  kind               ExecutiveBriefKind @default(DAILY)
  briefDate          DateTime           @db.Date
  greeting           String?
  todaysSummary      String             @db.Text
  todaysFocus        String?
  motivationalInsight String?
  motivationalQuote  String?
  estimatedWorkload  String?
  suggestedSchedule  String?            @db.Text
  topPriorities      Json?
  biggestOpportunities Json?
  biggestRisks       Json?
  campaignHealth     String?            @db.Text
  contentHealth      String?            @db.Text
  communityHealth    String?            @db.Text
  salesSignals       String?            @db.Text
  topTasks           Json?
  criticalNotifications Json?
  focusModeSnapshot  Json?
  workspace          Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand              Brand              @relation(fields: [brandId], references: [id], onDelete: Cascade)
  recommendations    DecisionRecommendation[]
  insights           MarketingInsight[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([brandId, kind, briefDate])
  @@index([workspaceId, briefDate])
}

model DecisionRecommendation {
  id              String         @id @default(cuid())
  brandId         String
  briefId         String?
  type            DecisionType   @default(OTHER)
  title           String
  summary         String         @db.Text
  status          DecisionStatus @default(PENDING)
  priority        Float          @default(50)
  confidence      Float          @default(0.7)
  businessImpact  Float          @default(50)
  expectedRoi     Float          @default(50)
  effort          Float          @default(50)
  urgency         Float          @default(50)
  reason          String         @db.Text
  whatHappened    String         @db.Text
  whyItMatters    String         @db.Text
  consequences    String         @db.Text
  recommendedAction String       @db.Text
  alternatives    Json?
  risks           String?        @db.Text
  sortOrder       Int            @default(0)
  assigneeId      String?
  postponedUntil  DateTime?
  brand           Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brief           ExecutiveBrief? @relation(fields: [briefId], references: [id], onDelete: SetNull)
  evidence        DecisionEvidence[]
  actions         DecisionAction[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([brandId, status, priority])
  @@index([briefId, sortOrder])
}

model DecisionEvidence {
  id               String                 @id @default(cuid())
  recommendationId String
  source           String
  label            String
  detail           String                 @db.Text
  metricValue      String?
  sortOrder        Int                    @default(0)
  recommendation   DecisionRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  createdAt        DateTime               @default(now())

  @@index([recommendationId, sortOrder])
}

model DecisionAction {
  id               String                 @id @default(cuid())
  recommendationId String
  actorId          String?
  type             DecisionActionType
  note             String?
  meta             Json?
  recommendation   DecisionRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  actor            User?                  @relation("DecisionActionActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt        DateTime               @default(now())

  @@index([recommendationId, createdAt])
}

model BusinessPriority {
  id        String   @id @default(cuid())
  brandId   String
  title     String
  detail    String?  @db.Text
  weight    Float    @default(50)
  active    Boolean  @default(true)
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId, active])
}

model ExecutiveMemory {
  id        String   @id @default(cuid())
  brandId   String
  category  String
  key       String
  content   String   @db.Text
  meta      Json?
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId, category])
  @@index([brandId, key])
}

model MarketingInsight {
  id        String          @id @default(cuid())
  brandId   String
  briefId   String?
  kind      String
  title     String
  detail    String          @db.Text
  severity  String          @default("info")
  brand     Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brief     ExecutiveBrief? @relation(fields: [briefId], references: [id], onDelete: SetNull)
  createdAt DateTime        @default(now())

  @@index([brandId, createdAt])
  @@index([briefId])
}

/// EPIC-020 — AI Marketing Workspace & Task Engine

enum MarketingTaskType {
  CONTENT_CREATION
  DESIGN
  VIDEO_EDITING
  COPYWRITING
  APPROVAL
  PUBLISHING
  CAMPAIGN_SETUP
  FOLLOW_UP
  MEETING
  RESEARCH
  CUSTOMER_RESPONSE
  CUSTOM
}

enum MarketingTaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  IN_REVIEW
  DONE
  ARCHIVED
}

enum MarketingTaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectHealth {
  HEALTHY
  AT_RISK
  DELAYED
  BLOCKED
  COMPLETED
}

enum TaskSource {
  STRATEGIST
  PLANNER
  CREATOR
  OPPORTUNITY
  COMMUNITY
  CRM
  ANALYTICS
  DECISION_CENTER
  CAMPAIGN_RECOMMENDATION
  MANUAL
}

model MarketingGoal {
  id          String              @id @default(cuid())
  brandId     String
  title       String
  description String?             @db.Text
  targetDate  DateTime?
  progress    Float               @default(0)
  status      String              @default("ACTIVE")
  brand       Brand               @relation(fields: [brandId], references: [id], onDelete: Cascade)
  projects    MarketingProject[]
  tasks       MarketingTask[]
  milestones  Milestone[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([brandId, status])
}

model MarketingProject {
  id            String         @id @default(cuid())
  workspaceId   String
  brandId       String
  goalId        String?
  campaignId    String?
  title         String
  description   String?        @db.Text
  health        ProjectHealth  @default(HEALTHY)
  status        String         @default("ACTIVE")
  startDate     DateTime?
  endDate       DateTime?
  source        TaskSource     @default(MANUAL)
  sourceKey     String?
  sourceContext Json?
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand         Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  goal          MarketingGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)
  campaign      Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  milestones    Milestone[]
  tasks         MarketingTask[]
  workflows     CampaignWorkflow[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([brandId, sourceKey])
  @@index([brandId, health, status])
  @@index([workspaceId])
}

model Milestone {
  id          String            @id @default(cuid())
  brandId     String
  projectId   String?
  goalId      String?
  title       String
  description String?           @db.Text
  dueDate     DateTime?
  completedAt DateTime?
  sortOrder   Int               @default(0)
  brand       Brand             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  project     MarketingProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  goal        MarketingGoal?    @relation(fields: [goalId], references: [id], onDelete: SetNull)
  tasks       MarketingTask[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([brandId, dueDate])
  @@index([projectId, sortOrder])
}

model TaskLabel {
  id        String             @id @default(cuid())
  brandId   String
  name      String
  color     String             @default("#14b8a6")
  brand     Brand              @relation(fields: [brandId], references: [id], onDelete: Cascade)
  tasks     MarketingTaskLabel[]
  createdAt DateTime           @default(now())

  @@unique([brandId, name])
}

model MarketingTask {
  id               String                 @id @default(cuid())
  brandId          String
  projectId        String?
  campaignId       String?
  goalId           String?
  milestoneId      String?
  parentId         String?
  title            String
  description      String?                @db.Text
  type             MarketingTaskType      @default(CUSTOM)
  status           MarketingTaskStatus    @default(TODO)
  priority         MarketingTaskPriority  @default(MEDIUM)
  dueDate          DateTime?
  startDate        DateTime?
  estimatedMinutes Int?
  platform         String?
  ownerId          String?
  createdById      String?
  source           TaskSource             @default(MANUAL)
  sourceKey        String?
  sourceContext    Json?
  checklist        Json?
  attachments      Json?
  sortOrder        Int                    @default(0)
  blockedReason    String?
  nextAction       String?
  brand            Brand                  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  project          MarketingProject?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  campaign         Campaign?              @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  goal             MarketingGoal?         @relation(fields: [goalId], references: [id], onDelete: SetNull)
  milestone        Milestone?             @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  parent           MarketingTask?         @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: SetNull)
  subtasks         MarketingTask[]        @relation("TaskSubtasks")
  owner            User?                  @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy        User?                  @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  labels           MarketingTaskLabel[]
  comments         TaskComment[]
  activities       TaskActivity[]
  watchers         TaskWatcher[]
  blockedBy        TaskDependency[]       @relation("DependencyBlocked")
  blocking         TaskDependency[]       @relation("DependencyBlocking")
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@unique([brandId, sourceKey])
  @@index([brandId, status, priority])
  @@index([brandId, dueDate])
  @@index([ownerId, status])
  @@index([projectId, sortOrder])
  @@index([parentId])
}

model MarketingTaskLabel {
  taskId  String
  labelId String
  task    MarketingTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label   TaskLabel     @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
}

model TaskComment {
  id        String        @id @default(cuid())
  taskId    String
  authorId  String?
  body      String        @db.Text
  mentions  String[]      @default([])
  task      MarketingTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User?         @relation("TaskCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([taskId, createdAt])
}

model TaskDependency {
  id           String        @id @default(cuid())
  fromTaskId   String
  toTaskId     String
  kind         String        @default("blocks")
  fromTask     MarketingTask @relation("DependencyBlocking", fields: [fromTaskId], references: [id], onDelete: Cascade)
  toTask       MarketingTask @relation("DependencyBlocked", fields: [toTaskId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())

  @@unique([fromTaskId, toTaskId])
  @@index([toTaskId])
}

model TaskActivity {
  id        String        @id @default(cuid())
  taskId    String
  actorId   String?
  kind      String
  message   String
  meta      Json?
  task      MarketingTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor     User?         @relation("TaskActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())

  @@index([taskId, createdAt])
}

model TaskWatcher {
  taskId String
  userId String
  task   MarketingTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User          @relation("TaskWatcher", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@id([taskId, userId])
}

