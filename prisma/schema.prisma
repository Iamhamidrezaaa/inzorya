generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum ContentStatus {
  IDEAS
  RESEARCH
  BRIEF
  DRAFT
  REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum ContentPlatform {
  INSTAGRAM
  FACEBOOK
  LINKEDIN
  X
  TIKTOK
  YOUTUBE
  BLOG
  EMAIL
  NEWSLETTER
  OTHER
}

enum ContentFormat {
  INSTAGRAM_REEL
  INSTAGRAM_CAROUSEL
  INSTAGRAM_STORY
  INSTAGRAM_POST
  FACEBOOK
  LINKEDIN
  X
  TIKTOK
  YOUTUBE
  SHORT
  NEWSLETTER
  BLOG
  OTHER
}

enum ContentPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CampaignStatus {
  PLANNING
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum ChannelPlatform {
  INSTAGRAM
  FACEBOOK
  WHATSAPP
  TELEGRAM
  X
  LINKEDIN
  YOUTUBE
  TIKTOK
}

enum ChannelStatus {
  DISCONNECTED
  CONNECTED
  PENDING
  ERROR
}

enum ConnectionHealth {
  HEALTHY
  PERMISSION_EXPIRED
  RECONNECT_REQUIRED
  SYNC_FAILED
  PENDING
}

enum OAuthSessionStatus {
  PENDING
  COMPLETED
  EXPIRED
  FAILED
  CONSUMED
}

enum TokenCredentialStatus {
  ACTIVE
  EXPIRED
  REVOKED
  ROTATING
}

enum SyncJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum WebhookSubscriptionStatus {
  DRAFT
  ACTIVE
  PAUSED
  ERROR
}

enum IntegrationAuditKind {
  OAUTH_START
  OAUTH_CALLBACK
  OAUTH_SUCCESS
  OAUTH_FAILURE
  TOKEN_STORED
  TOKEN_ROTATED
  TOKEN_REVOKED
  PERMISSION_CHANGE
  SYNC_QUEUED
  SYNC_COMPLETED
  SYNC_FAILED
  WEBHOOK_VALIDATED
  WEBHOOK_REJECTED
  SECURITY
  DISCONNECT
  RECONNECT
}

enum ConversationStatus {
  OPEN
  WAITING
  RESOLVED
  CLOSED
  ARCHIVED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  SYSTEM
}

enum MessageKind {
  TEXT
  IMAGE
  VIDEO
  VOICE
  FILE
  EMOJI
  LINK
  SYSTEM
}

enum MessageDeliveryStatus {
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum ConversationEventType {
  STARTED
  CHANNEL_CONNECTED
  ASSIGNED
  UNASSIGNED
  STATUS_CHANGED
  TAGGED
  UNTAGGED
  NOTE_ADDED
  STARRED
  UNSTARRED
  CLOSED
  REOPENED
  MESSAGE_SENT
}

model User {
  id            String            @id @default(cuid())
  name          String?
  email         String            @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  accounts      Account[]
  sessions      Session[]
  memberships   WorkspaceMember[]
  assigned      Conversation[]    @relation("ConversationAssignee")
  contentAssigned ContentItem[]   @relation("ContentAssignee")
  contentComments ContentComment[]
  inboxNotes    InternalNote[]
  inboxAssignments Assignment[]   @relation("AssignmentAssignee")
  inboxAssigner Assignment[]      @relation("AssignmentAssigner")
  conversationEvents ConversationEvent[]
  authoredMessages Message[]      @relation("MessageAuthor")
  conversationParts ConversationParticipant[]
  notifications Notification[]
  favorites     Favorite[]
  recentItems   RecentItem[]
  activities    Activity[]        @relation("ActivityActor")
  automationsCreated Automation[] @relation("AutomationCreator")
  automationVersions AutomationVersion[] @relation("AutomationVersionAuthor")
  oauthSessions      OAuthSession[]
  integrationAudits  IntegrationAuditLog[]
  promptsCreated     Prompt[] @relation("PromptCreator")
  strategyConversations StrategyConversation[] @relation("StrategyConversationOwner")
  strategyDocuments     StrategyDocument[]     @relation("StrategyDocumentAuthor")
  businessDecisions     BusinessDecision[]     @relation("BusinessDecisionActor")
  contentPlansCreated   ContentPlan[]          @relation("ContentPlanCreator")
  generationSessions    GenerationSession[]    @relation("GenerationSessionOwner")
  generatedContents     GeneratedContent[]     @relation("GeneratedContentAuthor")
  opportunityFeedback   OpportunityFeedback[]  @relation("OpportunityFeedbackAuthor")
  suggestedRepliesReviewed SuggestedReply[] @relation("SuggestedReplyReviewer")
  decisionActions DecisionAction[] @relation("DecisionActionActor")
  tasksOwned MarketingTask[] @relation("TaskOwner")
  tasksCreated MarketingTask[] @relation("TaskCreator")
  taskComments TaskComment[] @relation("TaskCommentAuthor")
  taskActivities TaskActivity[] @relation("TaskActivityActor")
  tasksWatching TaskWatcher[] @relation("TaskWatcher")
  plannerHandoffs PlannerHandoff[] @relation("PlannerHandoffActor")
  workflowAudits WorkflowAudit[] @relation("WorkflowAuditActor")
  agentExecutions AgentExecution[]
  contentDraftsCreated ContentDraft[] @relation("ContentDraftCreator")
  contentDraftVersions ContentDraftVersion[] @relation("ContentDraftVersionAuthor")
  contentDraftReviews ContentReview[] @relation("ContentDraftReviewer")
  socialOAuthStates SocialOAuthState[]
  contentSchedulesCreated ContentSchedule[] @relation("ContentScheduleCreator")
  contentScheduleHistory ContentScheduleHistory[] @relation("ContentScheduleHistoryAuthor")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model Workspace {
  id            String            @id @default(cuid())
  name          String
  slug          String            @unique
  members       WorkspaceMember[]
  brands        Brand[]
  notifications Notification[]
  activities    Activity[]
  favorites     Favorite[]
  recentItems   RecentItem[]
  prompts       Prompt[]
  aiTaskExecutions AITaskExecution[]
  usageMetrics  UsageMetric[]
  costRecords   CostRecord[]
  aiErrors      AIError[]
  memoryRecords MemoryRecord[]
  strategyConversations StrategyConversation[]
  contentPlans ContentPlan[]
  planningSessions PlanningSession[]
  generationSessions GenerationSession[]
  generatedContents GeneratedContent[]
  businessOpportunities BusinessOpportunity[]
  communityRules CommunityRule[]
  executiveBriefs ExecutiveBrief[]
  marketingProjects MarketingProject[]
  campaignRecommendations CampaignRecommendation[]
  campaignWorkflows CampaignWorkflow[]
  agentExecutions AgentExecution[]
  contentDrafts ContentDraft[]
  socialAccounts SocialAccount[]
  contentSchedules ContentSchedule[]
  socialPublications SocialPublication[]
  contentLearnings   ContentLearning[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(EDITOR)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Brand {
  id             String              @id @default(cuid())
  workspaceId    String
  name           String
  slug           String
  description    String?
  website        String?
  logoUrl        String?
  industry       String?
  brandVoice     String?             @db.Text
  targetAudience String?             @db.Text
  primaryColor   String?             @default("#14b8a6")
  secondaryColor String?             @default("#0f172a")
  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  businessProfile BusinessProfile?
  documents      KnowledgeDocument[]
  contents       ContentItem[]
  media          MediaAsset[]
  campaigns      Campaign[]
  templates      ContentTemplate[]
  editorialSlots EditorialCalendar[]
  contacts       Contact[]
  inboxTags      InboxTag[]
  savedReplies   SavedReply[]
  internalNotes  InternalNote[]
  channelConnections ChannelConnection[]
  conversations  Conversation[]
  automations    Automation[]
  connectedAccounts ConnectedAccount[]
  oauthSessions  OAuthSession[]
  webhookSubscriptions WebhookSubscription[]
  syncJobs       SyncJob[]
  integrationAudits IntegrationAuditLog[]
  analyticsSnapshots AnalyticsSnapshot[]
  kpis               Kpi[]
  audienceSnapshots  AudienceSnapshot[]
  contentMetrics     ContentMetric[]
  campaignMetrics    CampaignMetric[]
  channelMetrics     ChannelMetric[]
  insights           Insight[]
  reports            Report[]
  reportTemplates    ReportTemplate[]
  contextSnapshots   ContextSnapshot[]
  memoryRecords      MemoryRecord[]
  aiTaskExecutions   AITaskExecution[]
  marketingStrategy MarketingStrategy?
  businessBrain     BusinessBrain?
  strategyConversations StrategyConversation[]
  strategyDocuments     StrategyDocument[]
  businessDecisions     BusinessDecision[]
  businessMemories      BusinessMemory[]
  recommendations       Recommendation[]
  strategyTemplates     StrategyTemplate[]
  contentPlans          ContentPlan[]
  planningSessions      PlanningSession[]
  planningConstraints   PlanningConstraint[]
  planningTemplates     PlanningTemplate[]
  generationSessions    GenerationSession[]
  generatedContents     GeneratedContent[]
  businessOpportunities BusinessOpportunity[]
  opportunityFeedback   OpportunityFeedback[]
  opportunityOverrides  OpportunityOverride[]
  communityRules        CommunityRule[]
  autoReplyRules        AutoReplyRule[]
  customerProfiles      CustomerProfile[]
  suggestedReplies      SuggestedReply[]
  executiveBriefs       ExecutiveBrief[]
  decisionRecommendations DecisionRecommendation[]
  businessPriorities    BusinessPriority[]
  executiveMemories     ExecutiveMemory[]
  marketingInsights     MarketingInsight[]
  marketingGoals        MarketingGoal[]
  marketingProjects     MarketingProject[]
  marketingTasks        MarketingTask[]
  taskLabels            TaskLabel[]
  marketingMilestones   Milestone[]
  campaignRecommendations CampaignRecommendation[]
  campaignLearnings     CampaignLearning[]
  campaignWorkflows     CampaignWorkflow[]
  agentExecutions       AgentExecution[]
  contentDrafts         ContentDraft[]
  socialAccounts        SocialAccount[]
  contentSchedules      ContentSchedule[]
  socialPublications    SocialPublication[]
  contentLearnings      ContentLearning[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  archivedAt     DateTime?

  @@unique([workspaceId, slug])
  @@index([workspaceId])
}

/// Structured marketing strategy workspace — no AI generation; data for future planning.
model MarketingStrategy {
  id                 String            @id @default(cuid())
  brandId            String            @unique
  /// Selected marketing goal keys (e.g. increase_sales)
  goals              String[]          @default([])
  postingFrequency   String?
  preferredPlatforms String[]          @default([])
  /// REELS | CAROUSEL | STORY | SHORTS | POST
  contentTypes       String[]          @default([])
  tone               String?
  contentLength      String?
  ctaStyle           String?
  currentStage       String?
  nextStep           String?
  brand              Brand             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  personas           AudiencePersona[]
  competitors        Competitor[]
  pillars            ContentPillar[]
  roadmapTasks       RoadmapTask[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model AudiencePersona {
  id                String            @id @default(cuid())
  strategyId        String
  name              String
  age               String?
  gender            String?
  location          String?
  interests         String?           @db.Text
  painPoints        String?           @db.Text
  buyingMotivation  String?           @db.Text
  objections        String?           @db.Text
  goals             String?           @db.Text
  sortOrder         Int               @default(0)
  strategy          MarketingStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([strategyId, sortOrder])
}

model Competitor {
  id         String            @id @default(cuid())
  strategyId String
  name       String
  website    String?
  instagram  String?
  notes      String?           @db.Text
  sortOrder  Int               @default(0)
  strategy   MarketingStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([strategyId, sortOrder])
}

model ContentPillar {
  id          String            @id @default(cuid())
  strategyId  String
  name        String
  description String?
  color       String?           @default("#14b8a6")
  sortOrder   Int               @default(0)
  archivedAt  DateTime?
  strategy    MarketingStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  contents    ContentItem[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([strategyId, sortOrder])
}

model RoadmapTask {
  id         String            @id @default(cuid())
  strategyId String
  title      String
  done       Boolean           @default(false)
  sortOrder  Int               @default(0)
  strategy   MarketingStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([strategyId, sortOrder])
}

model BusinessProfile {
  id                    String   @id @default(cuid())
  brandId               String   @unique
  businessSummary       String?  @db.Text
  industry              String?
  website               String?
  country               String?
  languages             String[] @default([])
  businessGoals         String?  @db.Text
  mainProducts          String?  @db.Text
  targetAudience        String?  @db.Text
  competitors           String?  @db.Text
  brandPersonality      String?  @db.Text
  preferredTone         String?
  contentStyle          String?  @db.Text
  mainCta               String?
  postingFrequency      String?
  preferredPlatforms    String[] @default([])
  marketingChallenges   String?  @db.Text
  monthlyBudget         String?
  teamSize              String?
  onboardingStep        Int      @default(0)
  onboardingCompletedAt DateTime?
  brand                 Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

/// Catalog of supported social platforms. OAuth providers plug in via ChannelConnection later.
model SocialChannel {
  id          String              @id @default(cuid())
  platform    ChannelPlatform     @unique
  name        String
  description String?
  connections ChannelConnection[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model ChannelConnection {
  id                String              @id @default(cuid())
  brandId           String
  socialChannelId   String
  status            ChannelStatus       @default(DISCONNECTED)
  health            ConnectionHealth    @default(PENDING)
  accountName       String?
  accountHandle     String?
  profilePictureUrl String?
  /// Reserved for real OAuth account id
  externalAccountId String?
  /// Non-sensitive provider metadata only (never plaintext tokens)
  providerMeta      Json?
  connectedAt       DateTime?
  lastSyncAt        DateTime?
  nextSyncAt        DateTime?
  lastError         String?
  brand             Brand               @relation(fields: [brandId], references: [id], onDelete: Cascade)
  socialChannel     SocialChannel       @relation(fields: [socialChannelId], references: [id], onDelete: Cascade)
  permissions       ChannelPermission[]
  conversations     Conversation[]
  connectedAccounts ConnectedAccount[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([brandId, socialChannelId])
  @@index([brandId])
  @@index([status])
  @@index([health])
}

model ChannelPermission {
  id           String            @id @default(cuid())
  connectionId String
  scope        String
  label        String
  granted      Boolean           @default(false)
  connection   ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([connectionId, scope])
  @@index([connectionId])
}

model KnowledgeDocument {
  id        String   @id @default(cuid())
  brandId   String
  title     String
  body      String   @default("") @db.Text
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId])
  @@index([brandId, title])
}

model ContentItem {
  id             String                 @id @default(cuid())
  brandId        String
  title          String
  body           String                 @default("") @db.Text
  description    String?                @db.Text
  objective      String?                @db.Text
  targetAudience String?                @db.Text
  notes          String?                @db.Text
  status         ContentStatus          @default(IDEAS)
  platform       ContentPlatform        @default(INSTAGRAM)
  format         ContentFormat          @default(INSTAGRAM_POST)
  priority       ContentPriority        @default(MEDIUM)
  campaignId     String?
  pillarId       String?
  assigneeId     String?
  dueDate        DateTime?
  scheduledAt    DateTime?
  publishedAt    DateTime?
  sortOrder      Int                    @default(0)
  deletedAt      DateTime?
  brand          Brand                  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  campaign       Campaign?              @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  pillar         ContentPillar?         @relation(fields: [pillarId], references: [id], onDelete: SetNull)
  assignee       User?                  @relation("ContentAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  brief          ContentBrief?
  checklist      ContentChecklistItem[]
  comments       ContentComment[]
  attachments    ContentAttachment[]
  calendarSlots  EditorialCalendar[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([brandId, status, sortOrder])
  @@index([brandId, campaignId])
  @@index([brandId, dueDate])
  @@index([brandId, scheduledAt])
  @@index([deletedAt])
}

model ContentBrief {
  id             String      @id @default(cuid())
  contentId      String      @unique
  goal           String?     @db.Text
  hook           String?     @db.Text
  problem        String?     @db.Text
  solution       String?     @db.Text
  cta            String?
  targetAudience String?     @db.Text
  references     String?     @db.Text
  keywords       String[]    @default([])
  hashtags       String[]    @default([])
  competitors    String?     @db.Text
  content        ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model ContentChecklistItem {
  id        String      @id @default(cuid())
  contentId String
  label     String
  done      Boolean     @default(false)
  sortOrder Int         @default(0)
  content   ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([contentId, sortOrder])
}

model ContentComment {
  id        String      @id @default(cuid())
  contentId String
  userId    String
  body      String      @db.Text
  mentions  String[]    @default([])
  deletedAt DateTime?
  content   ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([contentId, createdAt])
}

model ContentAttachment {
  id        String      @id @default(cuid())
  contentId String
  mediaId   String?
  label     String?
  url       String
  content   ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)
  media     MediaAsset? @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  createdAt DateTime    @default(now())

  @@index([contentId])
}

model ContentTemplate {
  id          String          @id @default(cuid())
  brandId     String
  name        String
  description String?
  category    String?
  format      ContentFormat   @default(INSTAGRAM_POST)
  platform    ContentPlatform @default(INSTAGRAM)
  titleHint   String?
  briefGoal   String?         @db.Text
  briefHook   String?         @db.Text
  checklist   String[]        @default([])
  archivedAt  DateTime?
  brand       Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([brandId, archivedAt])
}

model EditorialCalendar {
  id        String       @id @default(cuid())
  brandId   String
  contentId String?
  title     String
  date      DateTime
  note      String?
  content   ContentItem? @relation(fields: [contentId], references: [id], onDelete: SetNull)
  brand     Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([brandId, date])
}

model MediaAsset {
  id           String              @id @default(cuid())
  brandId      String
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  kind         String              @default("image")
  tags         String[]            @default([])
  folder       String?
  deletedAt    DateTime?
  brand        Brand               @relation(fields: [brandId], references: [id], onDelete: Cascade)
  attachments  ContentAttachment[]
  createdAt    DateTime            @default(now())

  @@index([brandId, folder])
  @@index([brandId, deletedAt])
}

model Campaign {
  id          String         @id @default(cuid())
  brandId     String
  name        String
  description String?        @db.Text
  objective   String?        @db.Text
  platforms   String[]       @default([])
  startDate   DateTime?
  endDate     DateTime?
  budget      String?
  status      CampaignStatus @default(PLANNING)
  color       String?        @default("#14b8a6")
  icon        String?
  archivedAt  DateTime?
  brand       Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  contents    ContentItem[]
  projects    MarketingProject[]
  tasks       MarketingTask[]
  recommendations CampaignRecommendation[]
  workflows   CampaignWorkflow[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([brandId, status])
}

model Contact {
  id                String         @id @default(cuid())
  brandId           String
  name              String?
  instagramUsername String?
  phone             String?
  email             String?
  country           String?
  language          String?
  leadStatus        String?
  lifetimeValue     String?
  avatarUrl         String?
  joinedAt          DateTime?
  tags              String[]       @default([])
  notes             String?        @db.Text
  brand             Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  conversations     Conversation[]
  participants      ConversationParticipant[]
  internalNotes     InternalNote[]
  customerProfile   CustomerProfile?
  conversationMemories ConversationMemory[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([brandId])
  @@index([brandId, instagramUsername])
}

model Conversation {
  id            String             @id @default(cuid())
  brandId       String
  contactId     String
  channelId     String?
  status        ConversationStatus @default(OPEN)
  isUnread      Boolean            @default(true)
  unreadCount   Int                @default(0)
  isStarred     Boolean            @default(false)
  assigneeId    String?
  subject       String?
  lastMessageAt DateTime           @default(now())
  brand         Brand              @relation(fields: [brandId], references: [id], onDelete: Cascade)
  contact       Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channel       ChannelConnection? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  assignee      User?              @relation("ConversationAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages      Message[]
  participants  ConversationParticipant[]
  events        ConversationEvent[]
  internalNotes InternalNote[]
  assignments   Assignment[]
  tagLinks      ConversationTag[]
  intent        ConversationIntent?
  priority      ConversationPriority?
  sentiment     SentimentAnalysis?
  suggestedReplies SuggestedReply[]
  memories      ConversationMemory[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([brandId, status])
  @@index([brandId, isUnread])
  @@index([brandId, isStarred])
  @@index([brandId, lastMessageAt])
  @@index([contactId])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  contactId      String?
  userId         String?
  role           String       @default("customer")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
