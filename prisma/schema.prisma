enum AIProviderStatus {
  ACTIVE
  DISABLED
  DEGRADED
}

enum AIModelStatus {
  ACTIVE
  DISABLED
  DEPRECATED
}

enum PromptStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum AITaskExecutionStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum MemoryScope {
  CONVERSATION
  BUSINESS
  BRAND
  USER
  SESSION
  ACTIVITY
}

/// Provider catalog — credentials stay in env, never in DB plaintext.
model AIProvider {
  id           String           @id @default(cuid())
  key          String           @unique
  name         String
  status       AIProviderStatus @default(ACTIVE)
  priority     Int              @default(100)
  baseUrl      String?
  meta         Json?
  models       AIModel[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model AIModel {
  id              String        @id @default(cuid())
  providerId      String
  key             String        @unique
  displayName     String
  status          AIModelStatus @default(ACTIVE)
  contextLength   Int           @default(128000)
  supportsVision  Boolean       @default(false)
  supportsJson    Boolean       @default(true)
  supportsStreaming Boolean     @default(true)
  supportsTools   Boolean       @default(false)
  inputPricePer1M Float?
  outputPricePer1M Float?
  capabilities    String[]      @default([])
  meta            Json?
  provider        AIProvider    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  executions      AITaskExecution[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([providerId, status])
}

model Prompt {
  id          String       @id @default(cuid())
  workspaceId String?
  key         String
  name        String
  category    String
  description String?
  status      PromptStatus @default(DRAFT)
  currentVersion Int       @default(1)
  createdById String?
  workspace   Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User?        @relation("PromptCreator", fields: [createdById], references: [id], onDelete: SetNull)
  versions    PromptVersion[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([workspaceId, key])
  @@index([category, status])
}

model PromptVersion {
  id             String   @id @default(cuid())
  promptId       String
  version        Int
  systemPrompt   String   @db.Text
  developerPrompt String? @db.Text
  variables      String[] @default([])
  changelog      String?
  prompt         Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([promptId, version])
  @@index([promptId, createdAt])
}

model AITask {
  id            String   @id @default(cuid())
  key           String   @unique
  name          String
  description   String?
  category      String
  inputSchema   Json
  outputSchema  Json
  defaultModelKey String?
  priority      Int      @default(50)
  timeoutMs     Int      @default(30000)
  maxRetries    Int      @default(2)
  outputFormat  String   @default("json")
  promptKey     String?
  status        String   @default("active")
  meta          Json?
  executions    AITaskExecution[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AITaskExecution {
  id              String                @id @default(cuid())
  workspaceId     String?
  brandId         String?
  taskId          String
  modelId         String?
  status          AITaskExecutionStatus @default(QUEUED)
  input           Json?
  output          Json?
  contextSnapshotId String?
  providerKey     String?
  modelKey        String?
  latencyMs       Int?
  promptTokens    Int?
  completionTokens Int?
  totalTokens     Int?
  estimatedCostUsd Float?
  retryCount      Int                   @default(0)
  errorCode       String?
  errorMessage    String?
  startedAt       DateTime?
  finishedAt      DateTime?
  workspace       Workspace?            @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  brand           Brand?                @relation(fields: [brandId], references: [id], onDelete: SetNull)
  task            AITask                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  model           AIModel?              @relation(fields: [modelId], references: [id], onDelete: SetNull)
  contextSnapshot ContextSnapshot?      @relation(fields: [contextSnapshotId], references: [id], onDelete: SetNull)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([workspaceId, createdAt])
  @@index([brandId, createdAt])
  @@index([taskId, status])
  @@index([status, createdAt])
}

model ContextSnapshot {
  id          String   @id @default(cuid())
  brandId     String?
  taskKey     String?
  providers   String[] @default([])
  payload     Json
  tokenEstimate Int?
  brand       Brand?   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  executions  AITaskExecution[]
  createdAt   DateTime @default(now())

  @@index([brandId, createdAt])
}

model MemoryRecord {
  id          String      @id @default(cuid())
  workspaceId String?
  brandId     String?
  scope       MemoryScope
  subjectId   String?
  key         String
  content     String      @db.Text
  meta        Json?
  /// Embedding reserved — not implemented this sprint
  embeddingRef String?
  workspace   Workspace?  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand       Brand?      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([workspaceId, scope])
  @@index([brandId, scope])
  @@index([subjectId, key])
}

model UsageMetric {
  id           String   @id @default(cuid())
  workspaceId  String?
  day          DateTime @db.Date
  providerKey  String
  modelKey     String
  taskKey      String
  requests     Int      @default(0)
  successes    Int      @default(0)
  failures     Int      @default(0)
  retries      Int      @default(0)
  latencySumMs Int      @default(0)
  tokens       Int      @default(0)
  workspace    Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([workspaceId, day, providerKey, modelKey, taskKey])
  @@index([workspaceId, day])
}

model CostRecord {
  id             String   @id @default(cuid())
  workspaceId    String?
  executionId    String?
  providerKey    String
  modelKey       String
  estimatedUsd   Float
  promptTokens   Int      @default(0)
  completionTokens Int    @default(0)
  workspace      Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@index([workspaceId, createdAt])
}

model AIError {
  id          String   @id @default(cuid())
  workspaceId String?
  executionId String?
  code        String
  message     String
  providerKey String?
  modelKey    String?
  taskKey     String?
  meta        Json?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([code, createdAt])
}

/// EPIC AGENT-001 — Agent Runtime foundation (no autonomous agents yet)

enum AgentExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum AgentToolExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

model AgentExecution {
  id          String               @id @default(cuid())
  agentId     String
  workspaceId String
  brandId     String
  userId      String
  input       Json?
  status      AgentExecutionStatus @default(PENDING)
  result      Json?
  errorCode   String?
  errorMessage String?
  startedAt   DateTime?
  completedAt DateTime?
  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand       Brand                @relation(fields: [brandId], references: [id], onDelete: Cascade)
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolExecutions AgentToolExecution[]
  contentDrafts  ContentDraft[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([workspaceId, createdAt])
  @@index([brandId, createdAt])
  @@index([agentId, createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model AgentToolExecution {
  id               String                    @id @default(cuid())
  agentExecutionId String
  toolId           String
  sequence         Int
  input            Json?
  output           Json?
  status           AgentToolExecutionStatus  @default(PENDING)
  errorCode        String?
  errorMessage     String?
  durationMs       Int?
  startedAt        DateTime?
  completedAt      DateTime?
  agentExecution   AgentExecution            @relation(fields: [agentExecutionId], references: [id], onDelete: Cascade)
  createdAt        DateTime                  @default(now())

  @@index([agentExecutionId, sequence])
  @@index([toolId, createdAt])
}

/// EPIC-013 — Human-in-the-Loop Content Workspace

enum ContentDraftStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  READY
}

enum ContentDraftVersionSource {
  AI_CREATE
  AI_REGENERATE
  HUMAN_EDIT
}

enum ContentReviewStatus {
  SENT_FOR_REVIEW
  CHANGES_REQUESTED
  APPROVED
  READY
  NOTE
}

model ContentDraft {
  id                     String              @id @default(cuid())
  workspaceId            String
  brandId                String
  createdById            String
  sourceAgentExecutionId String?
  blueprintReference     Json?
  channel                String
  format                 String
  topic                  String
  objective              String?
  audience               String?
  pillar                 String?
  angle                  String?
  whyNow                 String?             @db.Text
  evidence               Json?
  /// Current creative payload (hooks, script, caption, etc.)
  contentPayload         Json
  status                 ContentDraftStatus  @default(DRAFT)
  currentVersion         Int                 @default(1)
  workspace              Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand                  Brand               @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdBy              User                @relation("ContentDraftCreator", fields: [createdById], references: [id], onDelete: Cascade)
  sourceAgentExecution   AgentExecution?     @relation(fields: [sourceAgentExecutionId], references: [id], onDelete: SetNull)
  versions               ContentDraftVersion[]
  reviews                ContentReview[]
  schedules              ContentSchedule[]
  publications           SocialPublication[]
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([brandId, status, updatedAt])
  @@index([workspaceId, createdAt])
  @@index([sourceAgentExecutionId])
}

model ContentDraftVersion {
  id             String                    @id @default(cuid())
  contentDraftId String
  version        Int
  source         ContentDraftVersionSource
  contentPayload Json
  changeSummary  String?
  component      String?
  instruction    String?
  createdById    String?
  contentDraft   ContentDraft              @relation(fields: [contentDraftId], references: [id], onDelete: Cascade)
  createdBy      User?                     @relation("ContentDraftVersionAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime                  @default(now())

  @@unique([contentDraftId, version])
  @@index([contentDraftId, createdAt])
}

model ContentReview {
  id             String              @id @default(cuid())
  contentDraftId String
  reviewerId     String
  status         ContentReviewStatus
  note           String?             @db.Text
  contentDraft   ContentDraft        @relation(fields: [contentDraftId], references: [id], onDelete: Cascade)
  reviewer       User                @relation("ContentDraftReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  createdAt      DateTime            @default(now())

  @@index([contentDraftId, createdAt])
  @@index([reviewerId, createdAt])
}

/// EPIC-014 — Social Account Integration Foundation
/// (Meta / TikTok / Pinterest are NOT registered here.)

enum SocialAccountStatus {
  NOT_CONNECTED
  CONNECTING
  CONNECTED
  EXPIRED
  REAUTH_REQUIRED
  ERROR
  DISCONNECTED
}

enum SocialOAuthStateStatus {
  PENDING
  CONSUMED
  EXPIRED
  FAILED
}

model SocialAccount {
  id                String              @id @default(cuid())
  workspaceId       String
  brandId           String
  /// Provider id e.g. "linkedin" — never meta/tiktok/pinterest in this EPIC
  platform          String
  platformAccountId String
  accountName       String?
  username          String?
  profileUrl        String?
  profileImageUrl   String?
  status            SocialAccountStatus @default(CONNECTING)
  /// Declared capabilities snapshot (booleans)
  capabilities      Json
  scopes            String[]            @default([])
  tokenExpiresAt    DateTime?
  connectedAt       DateTime?
  lastSyncedAt      DateTime?
  lastError         String?
  disconnectedAt    DateTime?
  workspace         Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand             Brand               @relation(fields: [brandId], references: [id], onDelete: Cascade)
  credential        SocialAccountCredential?
  schedules         ContentSchedule[]
  publications      SocialPublication[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([brandId, platform, platformAccountId])
  @@index([workspaceId, brandId])
  @@index([brandId, status])
  @@index([platform, status])
}

model SocialAccountCredential {
  id                   String    @id @default(cuid())
  socialAccountId      String    @unique
  accessCiphertext     String    @db.Text
  accessIv             String
  accessAuthTag        String
  refreshCiphertext    String?   @db.Text
  refreshIv            String?
  refreshAuthTag       String?
  tokenType            String    @default("Bearer")
  scopes               String[]  @default([])
  accessExpiresAt      DateTime?
  refreshExpiresAt     DateTime?
  keyVersion           Int       @default(1)
  socialAccount        SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model SocialOAuthState {
  id                   String                @id @default(cuid())
  stateHash            String                @unique
  userId               String
  workspaceId          String
  brandId              String
  platform             String
  redirectUri          String
  status               SocialOAuthStateStatus @default(PENDING)
  codeVerifierCipher   String?               @db.Text
  codeVerifierIv       String?
  codeVerifierAuthTag  String?
  expiresAt            DateTime
  consumedAt           DateTime?
  error                String?
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([brandId, status])
  @@index([expiresAt])
}

/// EPIC-015 — Intelligent Content Planner & Scheduling Foundation
/// (Named ContentSchedule — Prisma ContentPlan already used by strategic planner.)
/// PUBLISHED is intentionally absent.

enum ContentScheduleStatus {
  PLANNED
  SCHEDULED
  CANCELLED
}

enum ContentSchedulePlanningSource {
  AI
  HUMAN
}

model ContentSchedule {
  id              String                        @id @default(cuid())
  workspaceId     String
  brandId         String
  contentDraftId  String
  channel         String
  socialAccountId String?
  plannedDate     DateTime                      @db.Date
  /// HH:mm local time in timezone
  plannedTime     String
  timezone        String
  status          ContentScheduleStatus         @default(PLANNED)
  planningSource  ContentSchedulePlanningSource @default(AI)
  rationale       String?                       @db.Text
  evidence        Json?
  confidence      String?
  publishable     Boolean                       @default(false)
  publishabilityReason String?
  createdById     String?
  workspace       Workspace                     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand           Brand                         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  contentDraft    ContentDraft                  @relation(fields: [contentDraftId], references: [id], onDelete: Cascade)
  socialAccount   SocialAccount?                @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  createdBy       User?                         @relation("ContentScheduleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  history         ContentScheduleHistory[]
  publications    SocialPublication[]
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt

  @@index([brandId, plannedDate, status])
  @@index([workspaceId, plannedDate])
  @@index([contentDraftId, status])
  @@index([socialAccountId])
}

model ContentScheduleHistory {
  id              String                        @id @default(cuid())
  scheduleId      String
  plannedDate     DateTime                      @db.Date
  plannedTime     String
  timezone        String
  channel         String
  status          ContentScheduleStatus
  planningSource  ContentSchedulePlanningSource
  changeSummary   String?
  changedById     String?
  schedule        ContentSchedule               @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  changedBy       User?                         @relation("ContentScheduleHistoryAuthor", fields: [changedById], references: [id], onDelete: SetNull)
  createdAt       DateTime                      @default(now())

  @@index([scheduleId, createdAt])
}

/// EPIC-016 — Social Publishing Engine
/// PUBLISHED lives on SocialPublication — never on ContentSchedule.

enum SocialPublicationStatus {
  PENDING
  VALIDATING
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
}

model SocialPublication {
  id                 String                  @id @default(cuid())
  workspaceId        String
  brandId            String
  contentDraftId     String
  contentScheduleId  String
  socialAccountId    String
  platform           String
  status             SocialPublicationStatus @default(PENDING)
  externalPostId     String?
  externalUrl        String?
  publishedAt        DateTime?
  failureCode        String?
  failureMessageSafe String?
  idempotencyKey     String?
  attemptCount       Int                     @default(0)
  maxAttempts        Int                     @default(3)
  lastAttemptAt      DateTime?
  nextRetryAt        DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  /// Safe diagnostics only — never tokens
  diagnostics        Json?
  workspace          Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand              Brand                   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  contentDraft       ContentDraft            @relation(fields: [contentDraftId], references: [id], onDelete: Cascade)
  contentSchedule    ContentSchedule         @relation(fields: [contentScheduleId], references: [id], onDelete: Cascade)
  socialAccount      SocialAccount           @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  contentMetrics     ContentMetric[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@unique([contentScheduleId, socialAccountId])
  @@index([workspaceId, brandId, status])
  @@index([brandId, status, createdAt])
  @@index([externalPostId])
  @@index([status, nextRetryAt])
  @@index([idempotencyKey])
}

/// EPIC-014b — AI Marketing Strategist

enum StrategyConversationType {
  MARKETING_STRATEGY
  GROWTH_STRATEGY
  CAMPAIGN_PLANNING
  COMPETITOR_ANALYSIS
  AUDIENCE_ANALYSIS
  BRAND_POSITIONING
  CONTENT_DIRECTION
  SWOT
  GO_TO_MARKET
  LAUNCH_PLAN
  RETENTION
  COMMUNITY_GROWTH
}

enum StrategyMessageRole {
  USER
  ASSISTANT
}

enum StrategyDocumentStatus {
  ACTIVE
  ARCHIVED
}

enum BusinessDecisionStatus {
  CREATED
  UPDATED
  APPLIED
  REJECTED
  ARCHIVED
}

enum RecommendationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum RecommendationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RecommendationDifficulty {
  EASY
  MEDIUM
  HARD
}

model StrategyConversation {
  id             String                   @id @default(cuid())
  workspaceId    String
  brandId        String
  userId         String?
  title          String
  type           StrategyConversationType @default(MARKETING_STRATEGY)
  pinned         Boolean                  @default(false)
  archivedAt     DateTime?
  contextSources String[]                 @default([])
  confidence     Float?
  lastMessageAt  DateTime?
  workspace      Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand          Brand                    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  user           User?                    @relation("StrategyConversationOwner", fields: [userId], references: [id], onDelete: SetNull)
  messages       StrategyMessage[]
  documents      StrategyDocument[]
  recommendations Recommendation[]
  decisions      BusinessDecision[]
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@index([brandId, updatedAt])
  @@index([brandId, pinned])
  @@index([workspaceId, updatedAt])
}

model StrategyMessage {
  id                String             @id @default(cuid())
  conversationId    String
  role              StrategyMessageRole
  content           String             @db.Text
  structured        Json?
  contextUsed       String[]           @default([])
  confidence        Float?
  executionId       String?
  contextSnapshotId String?
  followUpKind      String?
  conversation      StrategyConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  recommendations   Recommendation[]
  createdAt         DateTime           @default(now())

  @@index([conversationId, createdAt])
}

model StrategyDocument {
  id             String                 @id @default(cuid())
  brandId        String
  conversationId String?
  createdById    String?
  title          String
  type           StrategyConversationType @default(MARKETING_STRATEGY)
  contentMd      String                 @db.Text
  structured     Json?
  status         StrategyDocumentStatus @default(ACTIVE)
  favorited      Boolean                @default(false)
  sharedInternally Boolean              @default(false)
  brand          Brand                  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  conversation   StrategyConversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  createdBy      User?                  @relation("StrategyDocumentAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([brandId, status, updatedAt])
  @@index([brandId, favorited])
}

model BusinessDecision {
  id               String                 @id @default(cuid())
  brandId          String
  conversationId   String?
