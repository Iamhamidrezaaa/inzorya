enum AutomationStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum AutomationNodeType {
  TRIGGER
  CONDITION
  ACTION
  DELAY
  BRANCH
  END
}

enum AutomationExecutionStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

/// Visual marketing automation — structure for future execution; no runtime engine yet.
model Automation {
  id             String            @id @default(cuid())
  brandId        String
  name           String
  description    String?           @db.Text
  category       String?
  status         AutomationStatus  @default(DRAFT)
  tags           String[]          @default([])
  version        Int               @default(1)
  nodeCount      Int               @default(0)
  executionCount Int               @default(0)
  createdById    String?
  brand          Brand             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdBy      User?             @relation("AutomationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  nodes          AutomationNode[]
  edges          AutomationEdge[]
  versions       AutomationVersion[]
  executions     AutomationExecution[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  archivedAt     DateTime?

  @@index([brandId, status])
  @@index([brandId, updatedAt])
  @@index([brandId, category])
}

model AutomationNode {
  id           String             @id @default(cuid())
  automationId String
  type         AutomationNodeType
  kind         String
  label        String
  description  String?
  config       Json               @default("{}")
  positionX    Float              @default(0)
  positionY    Float              @default(0)
  automation   Automation         @relation(fields: [automationId], references: [id], onDelete: Cascade)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([automationId])
}

model AutomationEdge {
  id           String     @id @default(cuid())
  automationId String
  sourceId     String
  targetId     String
  sourceHandle String?
  targetHandle String?
  label        String?
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@index([automationId])
}

model AutomationVersion {
  id           String     @id @default(cuid())
  automationId String
  version      Int
  snapshot     Json
  note         String?
  createdById  String?
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  createdBy    User?      @relation("AutomationVersionAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())

  @@unique([automationId, version])
  @@index([automationId, createdAt])
}

model AutomationExecution {
  id           String                     @id @default(cuid())
  automationId String
  status       AutomationExecutionStatus  @default(PENDING)
  meta         Json?
  startedAt    DateTime                   @default(now())
  finishedAt   DateTime?
  automation   Automation                 @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId, startedAt])
}

model AutomationTemplate {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?  @db.Text
  category    String?
  tags        String[] @default([])
  snapshot    Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Meta / social connected account — production integration layer.
model ConnectedAccount {
  id                String           @id @default(cuid())
  brandId           String
  connectionId      String?
  platform          ChannelPlatform
  /// instagram | facebook_pages | messenger
  product           String
  businessName      String?
  username          String?
  profilePictureUrl String?
  externalAccountId String?
  health            ConnectionHealth @default(PENDING)
  scopes            String[]         @default([])
  connectedAt       DateTime?
  lastSyncAt        DateTime?
  nextSyncAt        DateTime?
  lastError         String?
  providerMeta      Json?
  brand             Brand            @relation(fields: [brandId], references: [id], onDelete: Cascade)
  connection        ChannelConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  accessTokens      AccessToken[]
  refreshTokens     RefreshToken[]
  permissions       IntegrationPermission[]
  syncJobs          SyncJob[]
  syncHistory       SyncHistory[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  disconnectedAt    DateTime?

  @@index([brandId, platform])
  @@index([brandId, health])
  @@index([externalAccountId])
  @@index([connectionId])
}

model OAuthSession {
  id            String            @id @default(cuid())
  brandId       String
  userId        String
  platform      ChannelPlatform
  product       String
  /// CSRF state token (hashed at rest)
  stateHash     String
  /// Optional PKCE verifier (encrypted)
  codeVerifierCipher String?      @db.Text
  redirectUri   String
  status        OAuthSessionStatus @default(PENDING)
  scopes        String[]          @default([])
  expiresAt     DateTime
  consumedAt    DateTime?
  error         String?
  brand         Brand             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([stateHash])
  @@index([brandId, status])
  @@index([expiresAt])
}

model AccessToken {
  id                 String                @id @default(cuid())
  connectedAccountId String
  /// AES-GCM ciphertext (base64)
  ciphertext         String                @db.Text
  iv                 String
  authTag            String
  keyVersion         Int                   @default(1)
  expiresAt          DateTime?
  scopes             String[]              @default([])
  status             TokenCredentialStatus @default(ACTIVE)
  rotatedFromId      String?
  connectedAccount   ConnectedAccount      @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  revokedAt          DateTime?

  @@index([connectedAccountId, status])
  @@index([expiresAt])
}

model RefreshToken {
  id                 String                @id @default(cuid())
  connectedAccountId String
  ciphertext         String                @db.Text
  iv                 String
  authTag            String
  keyVersion         Int                   @default(1)
  expiresAt          DateTime?
  status             TokenCredentialStatus @default(ACTIVE)
  connectedAccount   ConnectedAccount      @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  revokedAt          DateTime?

  @@index([connectedAccountId, status])
}

model IntegrationPermission {
  id                 String           @id @default(cuid())
  connectedAccountId String
  scope              String
  label              String
  description        String?
  granted            Boolean          @default(false)
  required           Boolean          @default(true)
  connectedAccount   ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([connectedAccountId, scope])
  @@index([connectedAccountId])
}

model WebhookSubscription {
  id              String                    @id @default(cuid())
  brandId         String?
  platform        ChannelPlatform
  objectType      String
  fields          String[]                  @default([])
  callbackPath    String                    @default("/api/webhooks/meta")
  /// Hashed verify token — never store plaintext after creation response
  verifyTokenHash String?
  status          WebhookSubscriptionStatus @default(DRAFT)
  lastValidatedAt DateTime?
  meta            Json?
  brand           Brand?                    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([platform, status])
  @@index([brandId])
}

model SyncJob {
  id                 String           @id @default(cuid())
  brandId            String
  connectedAccountId String?
  jobType            String           @default("manual")
  status             SyncJobStatus    @default(QUEUED)
  progress           Int              @default(0)
  scheduledAt        DateTime         @default(now())
  startedAt          DateTime?
  finishedAt         DateTime?
  error              String?
  meta               Json?
  brand              Brand            @relation(fields: [brandId], references: [id], onDelete: Cascade)
  connectedAccount   ConnectedAccount? @relation(fields: [connectedAccountId], references: [id], onDelete: SetNull)
  history            SyncHistory[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([brandId, status])
  @@index([connectedAccountId, status])
  @@index([scheduledAt])
}

model SyncHistory {
  id                 String           @id @default(cuid())
  connectedAccountId String?
  syncJobId          String?
  status             SyncJobStatus
  message            String?
  error              String?
  meta               Json?
  connectedAccount   ConnectedAccount? @relation(fields: [connectedAccountId], references: [id], onDelete: SetNull)
  syncJob            SyncJob?         @relation(fields: [syncJobId], references: [id], onDelete: SetNull)
  createdAt          DateTime         @default(now())

  @@index([connectedAccountId, createdAt])
  @@index([syncJobId])
}

model IntegrationAuditLog {
  id        String               @id @default(cuid())
  brandId   String?
  userId    String?
  kind      IntegrationAuditKind
  message   String
  meta      Json?
  ip        String?
  userAgent String?
  brand     Brand?               @relation(fields: [brandId], references: [id], onDelete: SetNull)
  user      User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime             @default(now())

  @@index([brandId, createdAt])
  @@index([kind, createdAt])
}

/// Catalog of analytics metric definitions — ready for Meta/provider ingestion later.
model Metric {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  category    String
  unit        String   @default("count")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AnalyticsSnapshot {
  id          String   @id @default(cuid())
  brandId     String
  date        DateTime @db.Date
  granularity String   @default("day")
  source      String   @default("mock")
  /// Time-series metric bag: { followers, reach, impressions, ... }
  values      Json
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([brandId, date, granularity, source])
  @@index([brandId, date])
}

model Kpi {
  id            String   @id @default(cuid())
  brandId       String
  metricKey     String
  label         String
  currentValue  Float
  previousValue Float
  changePct     Float
  sparkline     Float[]  @default([])
  unit          String   @default("count")
  sortOrder     Int      @default(0)
  brand         Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([brandId, metricKey])
  @@index([brandId, sortOrder])
}

model AudienceSnapshot {
  id         String   @id @default(cuid())
  brandId    String
  date       DateTime @db.Date
  locations  Json
  ages       Json
  genders    Json
  languages  Json
  activeHours Json
  devices    Json
  brand      Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([brandId, date])
  @@index([brandId, date])
}

model ContentMetric {
  id                  String   @id @default(cuid())
  brandId             String
  /// EPIC-017 attribution / scoping (nullable for legacy seed rows)
  workspaceId         String?
  externalId          String
  /// SocialPublication.externalPostId — primary attribution key
  externalPostId      String?
  socialPublicationId String?
  socialAccountId     String?
  contentDraftId      String?
  title               String
  platform            String
  contentType         String
  author              String?
  status              String   @default("published")
  publishedAt         DateTime
  /// Snapshot day (UTC). Combined with externalId for idempotent sync keys.
  metricDate          DateTime? @db.Date
  collectedAt         DateTime?
  /// LINKEDIN_API | mock | legacy — never use mock for live ingestion
  source              String   @default("legacy")
  /// Which fields were actually returned by the provider (null ≠ zero)
  availability        Json?
  /// Sanitized provider extras — no credentials / tokens
  rawSanitized        Json?
  reach               Int?
  likes               Int?
  comments            Int?
  shares              Int?
  saves               Int?
  impressions         Int?
  views               Int?
  clicks              Int?
  ctr                 Float?
  engagement          Int?
  brand               Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  socialPublication   SocialPublication? @relation(fields: [socialPublicationId], references: [id], onDelete: SetNull)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([brandId, externalId])
  @@index([workspaceId, brandId])
  @@index([brandId, publishedAt])
  @@index([brandId, platform])
  @@index([brandId, contentType])
  @@index([brandId, socialAccountId])
  @@index([brandId, externalPostId])
  @@index([brandId, metricDate])
  @@index([brandId, source])
  @@index([socialPublicationId])
}

/// EPIC-018 — Content Learning & Performance Intelligence
/// Evidence-backed OBSERVATIONS from real ContentMetric data only.

enum ContentLearningType {
  FACT
  OBSERVATION
  INFERENCE
}

enum ContentLearningConfidence {
  HIGH
  MEDIUM
  LOW
}

enum ContentLearningStatus {
  ACTIVE
  STALE
  ARCHIVED
}

model ContentLearning {
  id              String                     @id @default(cuid())
  workspaceId     String
  brandId         String
  platform        String?
  dimension       String
  type            ContentLearningType        @default(OBSERVATION)
  statement       String                     @db.Text
  rationale       String                     @db.Text
  confidence      ContentLearningConfidence
  sampleSize      Int
  metric          String
  periodFrom      DateTime?
  periodTo        DateTime?
  lastObservedAt  DateTime
  status          ContentLearningStatus      @default(ACTIVE)
  fingerprint     String
  outlierPresent  Boolean                    @default(false)
  limitations     String[]                   @default([])
  usefulFeedback  Boolean?
  workspace       Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand           Brand                      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  evidence        ContentLearningEvidence[]
  versions        ContentLearningVersion[]
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@unique([brandId, fingerprint])
  @@index([workspaceId, brandId, status])
  @@index([brandId, dimension])
  @@index([brandId, platform])
  @@index([brandId, lastObservedAt])
}

model ContentLearningEvidence {
  id                  String   @id @default(cuid())
  learningId          String
  contentDraftId      String?
  socialPublicationId String?
  contentMetricId     String?
  evidenceType        String   @default("metric")
  metric              String
  value               Float?
  summary             String
  period              String?
  learning            ContentLearning @relation(fields: [learningId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now())

  @@index([learningId])
  @@index([contentDraftId])
  @@index([socialPublicationId])
  @@index([contentMetricId])
}

model ContentLearningVersion {
  id             String   @id @default(cuid())
  learningId     String
  version        Int
  statement      String   @db.Text
