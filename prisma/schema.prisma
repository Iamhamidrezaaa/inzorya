  THREADS
  LINKEDIN_POST
  FACEBOOK_POST
  X_POST
  NEWSLETTER
  BLOG_ARTICLE
  LANDING_PAGE_COPY
  EMAIL_CAMPAIGN
  PRODUCT_DESCRIPTION
  CTA
  HEADLINE
  HASHTAGS
}

enum CreatorObjective {
  BRAND_AWARENESS
  LEAD_GENERATION
  ENGAGEMENT
  SALES
  EDUCATION
  COMMUNITY
  RETENTION
  TRAFFIC
  LAUNCH
  SUPPORT
}

enum GenerationSessionStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum GeneratedContentStatus {
  DRAFT
  REVIEWED
  APPROVED
  PUSHED
  ARCHIVED
}

enum VariationStatus {
  ACTIVE
  FAVORITED
  ARCHIVED
  RESTORED
